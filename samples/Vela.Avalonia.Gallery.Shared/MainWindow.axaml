<vela:VelaWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vela="using:Vela.Avalonia.Controls"
                 xmlns:local="using:Vela.Avalonia.Gallery"
                 xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
                 x:Class="Vela.Avalonia.Gallery.MainWindow"
                 x:DataType="vm:MainViewModel"
                 Title="Vela.Avalonia Studio"
                 TitleBarHeight="36"
                 Width="1180"
                 Height="780"
                 MinWidth="860"
                 MinHeight="620"
                 FontFamily="Inter, sans-serif">
  <vela:VelaWindow.TrayIcon>
    <vela:VelaTrayIcon x:Name="AppTrayIcon"
                       ToolTipText="Vela Studio"
                       IconGeometry="{DynamicResource VelaIconSparkles}"
                       BadgeVariant="Dot"
                       BadgeTone="Accent"
                       Presentation="VelaMenu"
                       SurfaceMaterial="Solid"
                       FlyoutMinWidth="240">
      <vela:VelaTrayIcon.FlyoutHeader>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="4,2">
          <Border Width="28"
                  Height="28"
                  CornerRadius="8"
                  Background="{DynamicResource VelaAccentSubtleBrush}">
            <PathIcon Width="14"
                      Height="14"
                      Data="{DynamicResource VelaIconSparkles}"
                      Foreground="{DynamicResource VelaAccentBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="Vela Studio"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VelaForegroundBrush}" />
            <TextBlock Text="Avalonia 12.2"
                       FontSize="11"
                       Foreground="{DynamicResource VelaTextMutedBrush}" />
          </StackPanel>
          <vela:VelaBadge Grid.Column="2"
                          Tone="Success"
                          IsPill="True"
                          Content="Online"
                          VerticalAlignment="Center" />
        </Grid>
      </vela:VelaTrayIcon.FlyoutHeader>

      <vela:VelaMenuItem Header="Show Window"
                         Icon="{DynamicResource VelaIconHome}"
                         Shortcut="⌘O"
                         Command="{Binding SystemTray.TrayRestoreWindowCommand}" />
      <vela:VelaMenuItem Header="Toggle Theme"
                         Icon="{DynamicResource VelaIconPalette}"
                         Shortcut="⌘T"
                         Command="{Binding SystemTray.TrayToggleThemeCommand}" />
      <vela:VelaMenuItem Header="Background Sync"
                         IsChecked="{Binding SystemTray.IsBackgroundSyncEnabled}"
                         Command="{Binding SystemTray.TrayToggleSyncCommand}" />
      <vela:VelaMenuItem Header="Send Toast"
                         Icon="{DynamicResource VelaIconBell}"
                         Command="{Binding SystemTray.TraySendToastCommand}" />
      <vela:VelaMenuItem IsSeparator="True" />
      <vela:VelaMenuItem Header="Quit"
                         Icon="{DynamicResource VelaIconClose}"
                         Shortcut="⌘Q"
                         IsDestructive="True"
                         Command="{Binding SystemTray.TrayQuitCommand}" />

      <vela:VelaTrayIcon.PopoverContent>
        <StackPanel x:Name="TrayPopoverRoot" Spacing="12" Width="252" Margin="6,4" x:DataType="vm:MainViewModel">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Quick Controls"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource VelaForegroundBrush}"
                       VerticalAlignment="Center" />
            <vela:VelaBadge Grid.Column="1" Tone="Info" IsPill="True" Content="Popover" />
          </Grid>

          <Border CornerRadius="10"
                  Padding="10,8"
                  Background="{DynamicResource VelaSurfaceMutedBrush}"
                  BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                  BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock Text="Background Sync" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
              <vela:VelaSwitch Grid.Column="1" IsChecked="{Binding SystemTray.IsBackgroundSyncEnabled, Mode=TwoWay}" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <vela:VelaButton Variant="Primary"
                             Size="Small"
                             Content="Open Studio"
                             HorizontalAlignment="Stretch"
                             Command="{Binding SystemTray.TrayRestoreWindowCommand}" />
            <vela:VelaButton Grid.Column="1"
                             Variant="Secondary"
                             Size="Small"
                             Content="Quit"
                             HorizontalAlignment="Stretch"
                             Command="{Binding SystemTray.TrayQuitCommand}" />
          </Grid>
        </StackPanel>
      </vela:VelaTrayIcon.PopoverContent>
    </vela:VelaTrayIcon>
  </vela:VelaWindow.TrayIcon>

  <local:MainView x:Name="MainViewHost" />
</vela:VelaWindow>
