<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.Views.FeedbackPage"
             x:DataType="vm:FeedbackViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageRoot">
      <TextBlock Classes="pageTitle" Text="{DynamicResource StrNavFeedback}" />

      <!-- Row 1: Unified Dialog & Drawer Material Card -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="cardTitle" Text="VelaDialogHost &amp; VelaDrawerHost" VerticalAlignment="Center" />
            <vela:VelaSegmentedControl Grid.Column="1" SelectedIndex="{Binding OverlayMaterialIndex, Mode=TwoWay}">
              <vela:VelaSegmentedItem Content="{DynamicResource StrSolid}" />
              <vela:VelaSegmentedItem Content="{DynamicResource StrFrosted}" />
              <vela:VelaSegmentedItem Content="GlassCard" />
              <vela:VelaSegmentedItem Content="{DynamicResource StrLiquidGlass}" />
            </vela:VelaSegmentedControl>
          </Grid>

          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <vela:VelaButton Variant="Primary" Size="Small" Content="{DynamicResource StrConfirmDialog}" Command="{Binding ShowConfirmDialogCommand}" />
            <vela:VelaButton Variant="Danger" Size="Small" Content="{DynamicResource StrDestructive}" Command="{Binding ShowDestructiveDialogCommand}" />
            <vela:VelaButton Variant="Secondary" Size="Small" Content="{DynamicResource StrFormDialog}" Command="{Binding ShowCustomDialogCommand}" />
            <vela:VelaButton Variant="Secondary" Size="Small" Content="{DynamicResource StrPinnedBounce}" Command="{Binding ShowPinnedGlassDialogCommand}" />
            <vela:VelaButton Variant="Secondary" Size="Small" Content="{DynamicResource StrRightDrawer}" Command="{Binding OpenDrawerCommand}" CommandParameter="right" />
            <vela:VelaButton Variant="Ghost" Size="Small" Content="{DynamicResource StrLeftDrawer}" Command="{Binding OpenDrawerCommand}" CommandParameter="left" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Row 2: Toast + BusyOverlay -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="VelaToastHost" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <vela:VelaButton Variant="Secondary" Size="Small" Content="{DynamicResource StrSuccess}" Command="{Binding ShowToastCommand}" CommandParameter="success" />
              <vela:VelaButton Variant="Secondary" Size="Small" Content="{DynamicResource StrInfoUndo}" Command="{Binding ShowToastCommand}" CommandParameter="undo" />
              <vela:VelaButton Variant="Secondary" Size="Small" Content="{DynamicResource StrWarning}" Command="{Binding ShowToastCommand}" CommandParameter="warning" />
              <vela:VelaButton Variant="Danger" Size="Small" Content="{DynamicResource StrError}" Command="{Binding ShowToastCommand}" CommandParameter="danger" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardTitle" Text="VelaBusyOverlay" VerticalAlignment="Center" />
              <vela:VelaSwitch Grid.Column="1" IsChecked="{Binding IsBusy, Mode=TwoWay}" />
            </Grid>

            <vela:VelaBusyOverlay IsBusy="{Binding IsBusy}"
                                  Message="{DynamicResource StrIndexingShaders}"
                                  BlurRadius="10"
                                  CornerRadius="10">
              <Border Background="{DynamicResource VelaSurfaceMutedBrush}"
                      BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource StrBuildPipeline}" FontSize="13" FontWeight="SemiBold" />
                    <vela:VelaBadge Tone="Success" IsPill="True" Content="{DynamicResource StrActive}" HorizontalAlignment="Left" />
                  </StackPanel>
                  <vela:VelaButton Grid.Column="1"
                                   Variant="Secondary"
                                   Size="Small"
                                   Content="{DynamicResource StrRunTask}"
                                   VerticalAlignment="Center"
                                   Command="{Binding SimulateBusyCommand}" />
                </Grid>
              </Border>
            </vela:VelaBusyOverlay>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 3: Progress + Skeleton -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardTitle" Text="VelaProgress" VerticalAlignment="Center" />
              <vela:VelaSwitch Grid.Column="1" Content="{DynamicResource StrIndeterminate}" IsChecked="{Binding IsProgressIndeterminate, Mode=TwoWay}" />
            </Grid>

            <vela:VelaProgress Label="{DynamicResource StrUploadingArtifact}"
                               Value="{Binding ProgressValue}"
                               IsIndeterminate="{Binding IsProgressIndeterminate}" />

            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <vela:VelaButton Variant="Secondary" Size="Small" Content="0%" Command="{Binding SetProgressCommand}" CommandParameter="0" />
              <vela:VelaButton Variant="Secondary" Size="Small" Content="35%" Command="{Binding SetProgressCommand}" CommandParameter="35" />
              <vela:VelaButton Variant="Secondary" Size="Small" Content="72%" Command="{Binding SetProgressCommand}" CommandParameter="72" />
              <vela:VelaButton Variant="Primary" Size="Small" Content="100%" Command="{Binding SetProgressCommand}" CommandParameter="100" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardTitle" Text="VelaSkeleton" VerticalAlignment="Center" />
              <vela:VelaSwitch Grid.Column="1" Content="{DynamicResource StrLoading}" IsChecked="{Binding IsSkeletonLoading, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <vela:VelaSkeleton Width="42" Height="42" IsCircle="True" IsLoading="{Binding IsSkeletonLoading}">
                <Border Width="42" Height="42" CornerRadius="999" Background="{DynamicResource VelaAccentSubtleBrush}">
                  <TextBlock Text="VU" FontWeight="SemiBold" Foreground="{DynamicResource VelaAccentStrongBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </vela:VelaSkeleton>

              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <vela:VelaSkeleton Height="15" Width="140" HorizontalAlignment="Left" IsLoading="{Binding IsSkeletonLoading}">
                  <TextBlock Text="{DynamicResource StrBrandTitle}" FontSize="13.5" FontWeight="SemiBold" />
                </vela:VelaSkeleton>
                <vela:VelaSkeleton Height="12" IsLoading="{Binding IsSkeletonLoading}">
                  <TextBlock Text="Avalonia 12.2 · OKLCH" FontSize="12" Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                </vela:VelaSkeleton>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 4: VelaAlert -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="cardTitle" Text="VelaAlert" VerticalAlignment="Center" />
            <vela:VelaButton Grid.Column="1" Variant="Ghost" Size="Small" Content="{DynamicResource StrRestore}" Command="{Binding RestoreAlertsCommand}" />
          </Grid>

          <vela:VelaAlert x:Name="AlertInfo" Tone="Info" Title="{DynamicResource StrAlertInfoTitle}" Description="{DynamicResource StrAlertInfoDesc}" IsDismissible="True" />
          <vela:VelaAlert x:Name="AlertSuccess" Tone="Success" Title="{DynamicResource StrAlertSuccessTitle}" Description="{DynamicResource StrAlertSuccessDesc}" IsDismissible="True" />
          <vela:VelaAlert x:Name="AlertWarning" Tone="Warning" Title="{DynamicResource StrAlertWarnTitle}" Description="{DynamicResource StrAlertWarnDesc}" IsDismissible="True" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
