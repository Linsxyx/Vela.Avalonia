<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.Views.PickersPage"
             x:DataType="vm:PickersViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageRoot">
      <TextBlock Classes="pageTitle" Text="{DynamicResource StrNavPickers}" />

      <!-- Row 1: VelaRadioCards -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="cardTitle" Text="VelaRadioCards" VerticalAlignment="Center" />
            <vela:VelaSegmentedControl Grid.Column="1" SelectedIndex="{Binding RadioLayoutIndex, Mode=TwoWay}">
              <vela:VelaSegmentedItem Content="{DynamicResource StrGrid}" />
              <vela:VelaSegmentedItem Content="{DynamicResource StrList}" />
            </vela:VelaSegmentedControl>
          </Grid>

          <vela:VelaRadioCards Layout="{Binding RadioCardsLayout}"
                               SelectedIndex="{Binding SelectedPlanCardIndex, Mode=TwoWay}">
            <vela:VelaRadioCardItem Header="{DynamicResource StrPlanStarter}"
                                    Description="{DynamicResource StrPlanStarterDesc}"
                                    Meta="$0 / mo"
                                    Icon="{DynamicResource VelaIconHome}" />
            <vela:VelaRadioCardItem Header="{DynamicResource StrPlanPro}"
                                    Description="{DynamicResource StrPlanProDesc}"
                                    Meta="$24 / mo"
                                    Icon="{DynamicResource VelaIconSparkles}" />
            <vela:VelaRadioCardItem Header="{DynamicResource StrPlanEnterprise}"
                                    Description="{DynamicResource StrPlanEnterpriseDesc}"
                                    Meta="$89 / mo"
                                    Icon="{DynamicResource VelaIconLayers}" />
          </vela:VelaRadioCards>
        </StackPanel>
      </Border>

      <!-- Row 2: Select / ComboBox / DatePicker + Inline Calendar -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="VelaSelect, VelaComboBox &amp; VelaDatePicker" />

            <vela:VelaSelect Label="{DynamicResource StrRegion}"
                             PlaceholderText="{DynamicResource StrChooseRegion}"
                             SelectedIndex="{Binding SelectedRegionIndex, Mode=TwoWay}">
              <x:String>Tokyo (ap-northeast-1)</x:String>
              <x:String>Singapore (ap-southeast-1)</x:String>
              <x:String>Oregon (us-west-2)</x:String>
              <x:String>Frankfurt (eu-central-1)</x:String>
            </vela:VelaSelect>

            <vela:VelaComboBox Label="{DynamicResource StrFramework}"
                               PlaceholderText="{DynamicResource StrFilterFrameworks}"
                               ItemsSource="{Binding Frameworks}"
                               SelectedItem="{Binding SelectedFramework, Mode=TwoWay}" />

            <vela:VelaDatePicker Label="{DynamicResource StrReleaseDate}"
                                 PlaceholderText="{DynamicResource StrPickDate}"
                                 SelectedDate="{Binding SelectedReleaseDate, Mode=TwoWay}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <TextBlock Classes="cardTitle" Text="VelaCalendar" />
            <vela:VelaCalendar SelectedDate="{Binding SelectedCalendarDate, Mode=TwoWay}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 3: Menus, Popover & ContextMenu -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="cardTitle" Text="{DynamicResource StrMenusPopoverCtx}" />

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" VerticalAlignment="Center">
              <vela:VelaDropdownButton Content="{DynamicResource StrActionsMenu}"
                                       LeadingIcon="{DynamicResource VelaIconList}">
                <vela:VelaMenuItem Header="{DynamicResource StrRename}" Icon="{DynamicResource VelaIconEdit}" Shortcut="⌘R" Click="OnRenameClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrDuplicate}" Icon="{DynamicResource VelaIconCopy}" Shortcut="⌘D" Click="OnDuplicateClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrShareLink}" Icon="{DynamicResource VelaIconShare}" Shortcut="⇧⌘C" Click="OnShareClick" />
                <vela:VelaMenuItem IsSeparator="True" />
                <vela:VelaMenuItem Header="{DynamicResource StrDelete}" Icon="{DynamicResource VelaIconTrash}" Shortcut="⌫" IsDestructive="True" Click="OnDeleteClick" />
              </vela:VelaDropdownButton>

              <vela:VelaPopover IsOpen="{Binding IsPopoverOpen, Mode=TwoWay}"
                                Placement="BottomEdgeAlignedLeft">
                <vela:VelaButton Variant="Secondary" Size="Small" Content="{DynamicResource StrOpenPopover}" />
                <vela:VelaPopover.PopoverContent>
                  <StackPanel Spacing="10" Width="220">
                    <TextBlock Text="{DynamicResource StrDisplay}" FontSize="13.5" FontWeight="SemiBold" />
                    <vela:VelaCheckBox Content="{DynamicResource StrPerformanceBar}" IsChecked="True" />
                    <vela:VelaCheckBox Content="{DynamicResource StrSnapDetents}" IsChecked="True" />
                    <vela:VelaButton Variant="Primary"
                                     Size="Small"
                                     HorizontalAlignment="Right"
                                     Content="{DynamicResource StrDone}"
                                     Command="{Binding ClosePopoverCommand}" />
                  </StackPanel>
                </vela:VelaPopover.PopoverContent>
              </vela:VelaPopover>
            </WrapPanel>

            <Border x:Name="ContextMenuArea"
                    Grid.Column="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Background="{DynamicResource VelaSurfaceMutedBrush}"
                    BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                    BorderThickness="1"
                    Cursor="Hand">
              <vela:VelaContextMenu.Menu>
                <vela:VelaContextMenu x:Name="DemoContextMenu">
                  <vela:VelaMenuItem Header="{DynamicResource StrEdit}" Icon="{DynamicResource VelaIconEdit}" Shortcut="⌘E" Click="OnCtxEditClick" />
                  <vela:VelaMenuItem Header="{DynamicResource StrCopyPath}" Icon="{DynamicResource VelaIconCopy}" Shortcut="⌘C" Click="OnCtxCopyClick" />
                  <vela:VelaMenuItem Header="{DynamicResource StrShareSubmenu}" Icon="{DynamicResource VelaIconShare}">
                    <vela:VelaMenuItem Header="{DynamicResource StrShareLink}" Icon="{DynamicResource VelaIconGlobe}" Shortcut="⇧⌘C" Click="OnShareClick" />
                    <vela:VelaMenuItem Header="{DynamicResource StrDuplicate}" Icon="{DynamicResource VelaIconCopy}" Shortcut="⌘D" Click="OnDuplicateClick" />
                  </vela:VelaMenuItem>
                  <vela:VelaMenuItem IsSeparator="True" />
                  <vela:VelaMenuItem Header="{DynamicResource StrDelete}" Icon="{DynamicResource VelaIconTrash}" Shortcut="⌫" IsDestructive="True" Click="OnCtxDeleteClick" />
                </vela:VelaContextMenu>
              </vela:VelaContextMenu.Menu>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{DynamicResource StrRightClickHint}"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="{DynamicResource VelaTextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <vela:VelaButton Grid.Column="1"
                                 Variant="Ghost"
                                 Size="Small"
                                 Content="{DynamicResource StrOpenContextMenu}"
                                 Click="OnOpenContextMenuClick" />
              </Grid>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Row 4: VelaMenuBar -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="cardTitle" Text="VelaMenuBar" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="10" LineSpacing="8" VerticalAlignment="Center">
              <vela:VelaSwitch Content="{DynamicResource StrCompact}" IsChecked="{Binding MenuBarCompact, Mode=TwoWay}" VerticalAlignment="Center" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding MenuBarMaterialIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="{DynamicResource StrSolid}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrFrosted}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrGlassCard}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrLiquidGlass}" />
              </vela:VelaSegmentedControl>
            </WrapPanel>
          </Grid>

          <Border CornerRadius="10"
                  Padding="8,6"
                  Background="{DynamicResource VelaSurfaceMutedBrush}"
                  BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                  BorderThickness="1">
            <vela:VelaMenuBar IsCompact="{Binding MenuBarCompact}"
                              SurfaceMaterial="{Binding MenuBarMaterial}">
              <vela:VelaMenuBarItem Header="{DynamicResource StrMenuFile}">
                <vela:VelaMenuItem Header="{DynamicResource StrNewFile}" Icon="{DynamicResource VelaIconFile}" Shortcut="⌘N" Click="OnMenuBarNewClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrExport}" Icon="{DynamicResource VelaIconDownload}" Shortcut="⇧⌘E" Click="OnMenuBarExportClick" />
                <vela:VelaMenuItem IsSeparator="True" />
                <vela:VelaMenuItem Header="{DynamicResource StrDelete}" Icon="{DynamicResource VelaIconTrash}" IsDestructive="True" Click="OnDeleteClick" />
              </vela:VelaMenuBarItem>
              <vela:VelaMenuBarItem Header="{DynamicResource StrMenuEdit}">
                <vela:VelaMenuItem Header="{DynamicResource StrRename}" Icon="{DynamicResource VelaIconEdit}" Shortcut="⌘R" Click="OnRenameClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrDuplicate}" Icon="{DynamicResource VelaIconCopy}" Shortcut="⌘D" Click="OnDuplicateClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrShareLink}" Icon="{DynamicResource VelaIconShare}" Shortcut="⇧⌘C" Click="OnShareClick" />
              </vela:VelaMenuBarItem>
              <vela:VelaMenuBarItem Header="{DynamicResource StrMenuView}">
                <vela:VelaMenuItem Header="{DynamicResource StrToggleGrid}" Icon="{DynamicResource VelaIconTable}" Shortcut="⌘'" Click="OnMenuBarGridClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrZoomReset}" Icon="{DynamicResource VelaIconSearch}" Shortcut="⌘0" Click="OnMenuBarZoomClick" />
              </vela:VelaMenuBarItem>
            </vela:VelaMenuBar>
          </Border>
        </StackPanel>
      </Border>

      <!-- Row 4: ColorPicker -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="cardTitle" Text="VelaColorPicker" />

          <WrapPanel Orientation="Horizontal" ItemSpacing="20" LineSpacing="14">
            <vela:VelaColorPicker IsInline="True"
                                  Label="{DynamicResource StrSurface}"
                                  SelectedColor="{Binding InlineColor, Mode=TwoWay}" />

            <StackPanel Spacing="12" Width="240" VerticalAlignment="Top">
              <Border Height="92"
                      CornerRadius="12"
                      Background="{Binding PreviewBrush}"
                      Padding="14">
                <TextBlock Text="{Binding PreviewHex}"
                           FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Bottom" />
              </Border>

              <vela:VelaColorPicker Label="{DynamicResource StrSecondaryAccent}"
                                    SelectedColor="{Binding SecondaryColor, Mode=TwoWay}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
