<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.Views.ShowcasePage"
             x:DataType="vm:ShowcaseViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageRoot">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="pageTitle" Text="{DynamicResource StrNavShowcase}" />
          <TextBlock Text="{DynamicResource StrShowcaseSubtitle}"
                     FontSize="13"
                     Foreground="{DynamicResource VelaTextSecondaryBrush}" />
        </StackPanel>
      </Grid>

      <!-- 1. Glass Menu Card -->
      <Border Classes="card">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="cardTitle" Text="Glass menu" VerticalAlignment="Center" />
                <vela:VelaBadge Tone="Accent" Size="Small" IsPill="True" Content="GPU Backdrop · Morph" />
              </StackPanel>
              <TextBlock Text="{DynamicResource StrGlassMenuDesc}"
                         FontSize="12.5"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource VelaTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <vela:VelaButton Variant="Secondary"
                               Size="Small"
                               Content="{DynamicResource StrToggleMenu}"
                               Click="OnToggleGlassMenuClick" />
            </StackPanel>
          </Grid>

          <!-- Architectural Glass Stage -->
          <Border CornerRadius="20"
                  BorderBrush="{DynamicResource VelaBorderBrush}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  Height="380">
            <Grid>
              <!-- Sky & architectural dusk/pool backdrop for vivid frosted glass refraction -->
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#FF3882D6" Offset="0" />
                    <GradientStop Color="#FF63A6E8" Offset="0.34" />
                    <GradientStop Color="#FFD8E4F0" Offset="0.62" />
                    <GradientStop Color="#FFE7EEF4" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>

              <!-- Stylized modern villa & pool silhouettes behind the glass -->
              <Canvas IsHitTestVisible="False">
                <!-- Sunlit cloud bloom -->
                <Ellipse Canvas.Left="-40" Canvas.Top="-40" Width="340" Height="220" Fill="#55FFFFFF" />
                <Ellipse Canvas.Left="540" Canvas.Top="-30" Width="280" Height="180" Fill="#3893C5FD" />

                <!-- Upper dark architectural wing -->
                <Border Canvas.Left="190" Canvas.Top="64" Width="560" Height="74" Background="#FF273142" />
                <Border Canvas.Left="240" Canvas.Top="48" Width="220" Height="22" Background="#FF1E2634" />

                <!-- Greenery terrace strip -->
                <Border Canvas.Left="150" Canvas.Top="132" Width="620" Height="14" CornerRadius="4" Background="#FF3F6A4A" />

                <!-- Concrete cantilever roof -->
                <Border Canvas.Left="120" Canvas.Top="142" Width="680" Height="24" Background="#FFD5DBE3" />

                <!-- Glass facade & dark mullions -->
                <Border Canvas.Left="140" Canvas.Top="166" Width="620" Height="82" Background="#FF182530" Opacity="0.88" />
                <Border Canvas.Left="200" Canvas.Top="166" Width="88" Height="82" Background="#FF2A4A5E" Opacity="0.72" />
                <Border Canvas.Left="320" Canvas.Top="166" Width="110" Height="82" Background="#FF3B667D" Opacity="0.64" />
                <Border Canvas.Left="460" Canvas.Top="166" Width="96" Height="82" Background="#FF213C4E" Opacity="0.72" />
                <Border Canvas.Left="590" Canvas.Top="166" Width="120" Height="82" Background="#FF2E5469" Opacity="0.66" />

                <!-- Pool deck & turquoise infinity pool -->
                <Border Canvas.Left="0" Canvas.Top="246" Width="1200" Height="150" Background="#FFE8EDF2" />
                <Border Canvas.Left="0" Canvas.Top="248" Width="460" Height="74" CornerRadius="0,12,12,0">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Color="#FF0E4B68" Offset="0" />
                      <GradientStop Color="#FF1D7496" Offset="0.55" />
                      <GradientStop Color="#FF5CB0CA" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <!-- Pool light shimmer -->
                <Border Canvas.Left="60" Canvas.Top="264" Width="280" Height="6" CornerRadius="3" Background="#44FFFFFF" />
                <Border Canvas.Left="120" Canvas.Top="282" Width="210" Height="4" CornerRadius="2" Background="#33FFFFFF" />
              </Canvas>

              <!-- Top-left: Morphing VelaGlassMenu -->
              <vela:VelaGlassMenu x:Name="HeroGlassMenu"
                                  Margin="16"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  IsOpen="True"
                                  MenuWidth="232"
                                  BlurRadius="44"
                                  TintLevel="{Binding GlassTintLevel}">
                <vela:VelaMenuItem Header="Favorite"
                                   Icon="{DynamicResource VelaIconHeart}"
                                   Shortcut="F"
                                   IsChecked="{Binding IsFavorite}"
                                   Command="{Binding ToggleFavoriteCommand}" />
                <vela:VelaMenuItem Header="Copy link"
                                   Icon="{DynamicResource VelaIconLink}"
                                   Shortcut="⌘L"
                                   Command="{Binding RunGlassActionCommand}"
                                   CommandParameter="Link copied to clipboard" />
                <vela:VelaMenuItem Header="Duplicate"
                                   Icon="{DynamicResource VelaIconCopy}"
                                   Shortcut="⌘D"
                                   Command="{Binding RunGlassActionCommand}"
                                   CommandParameter="Duplicated Villa_04.png" />
                <vela:VelaMenuItem IsSeparator="True" />
                <vela:VelaMenuItem Header="Move to"
                                   Icon="{DynamicResource VelaIconFolder}">
                  <vela:VelaMenuItem Header="Architecture"
                                     Icon="{DynamicResource VelaIconHome}"
                                     Command="{Binding RunGlassActionCommand}"
                                     CommandParameter="Moved to Architecture" />
                  <vela:VelaMenuItem Header="Favorites"
                                     Icon="{DynamicResource VelaIconHeart}"
                                     Command="{Binding RunGlassActionCommand}"
                                     CommandParameter="Moved to Favorites" />
                  <vela:VelaMenuItem Header="Archive"
                                     Icon="{DynamicResource VelaIconInbox}"
                                     Command="{Binding RunGlassActionCommand}"
                                     CommandParameter="Moved to Archive" />
                </vela:VelaMenuItem>
                <vela:VelaMenuItem Header="Download"
                                   Icon="{DynamicResource VelaIconDownload}"
                                   Shortcut="⇧⌘S"
                                   Command="{Binding RunGlassActionCommand}"
                                   CommandParameter="Downloading full resolution..." />
                <vela:VelaMenuItem IsSeparator="True" />
                <vela:VelaMenuItem Header="Delete"
                                   Icon="{DynamicResource VelaIconTrash}"
                                   Shortcut="⌫"
                                   IsDestructive="True"
                                   Command="{Binding RunGlassActionCommand}"
                                   CommandParameter="Moved item to Trash" />
              </vela:VelaGlassMenu>

              <!-- Top-right: Favorite status badge matching reference -->
              <Border Margin="16"
                      Width="38"
                      Height="38"
                      CornerRadius="19"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      IsVisible="{Binding IsFavorite}"
                      Background="#CCDBEAFE"
                      BorderBrush="#AAFFFFFF"
                      BorderThickness="1"
                      BoxShadow="{DynamicResource VelaShadowResting}">
                <PathIcon Width="16"
                          Height="16"
                          Data="{DynamicResource VelaIconHeartFilled}"
                          Foreground="#FF2563EB" />
              </Border>

              <!-- Bottom-center: Floating glass status toast pill -->
              <Border Margin="0,0,0,16"
                      Padding="16,8"
                      CornerRadius="999"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Background="#D9FFFFFF"
                      BorderBrush="#AAFFFFFF"
                      BorderThickness="1"
                      BoxShadow="{DynamicResource VelaShadowResting}">
                <TextBlock Text="{Binding GlassMenuStatus}"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="#FF18181B" />
              </Border>
            </Grid>
          </Border>

          <!-- Glass Menu Controls Footer -->
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource StrTintLevel}"
                         FontSize="12"
                         Foreground="{DynamicResource VelaTextMutedBrush}"
                         VerticalAlignment="Center" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding GlassTintIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="None" />
                <vela:VelaSegmentedItem Content="Standard" />
                <vela:VelaSegmentedItem Content="High" />
              </vela:VelaSegmentedControl>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="{DynamicResource StrGlassMenuHint}"
                       FontSize="11.5"
                       Foreground="{DynamicResource VelaTextMutedBrush}"
                       VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 2. Payment Flow Card -->
      <Border Classes="card">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Classes="cardTitle" Text="Payment flow" VerticalAlignment="Center" />
                <vela:VelaBadge Tone="Accent" Size="Small" IsPill="True" Content="Live · keyboard ready" />
              </StackPanel>
              <TextBlock Text="{DynamicResource StrPaymentFlowDesc}"
                         FontSize="12.5"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource VelaTextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <vela:VelaButton x:Name="PlayPauseBtn"
                               Variant="Secondary"
                               Size="Small"
                               Content="{DynamicResource StrPause}"
                               Click="OnPlayPauseClick" />
              <vela:VelaButton Variant="Secondary"
                               Size="Small"
                               Content="{DynamicResource StrRestart}"
                               Click="OnRestartClick" />
              <vela:VelaButton Variant="Ghost"
                               Size="Small"
                               Content="{DynamicResource StrStepNext}"
                               Click="OnStepNextClick" />
            </StackPanel>
          </Grid>

          <!-- The Payment Flow Control -->
          <vela:VelaPaymentFlow x:Name="PaymentFlowControl"
                                Amount="{Binding PaymentAmount}"
                                InitialBalance="{Binding InitialBalance}"
                                IsLooping="{Binding IsLooping}"
                                PlaybackSpeed="{Binding PlaybackSpeed}"
                                AutoPlay="True" />

          <!-- Interactive Controls Footer -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource StrAmount}"
                         FontSize="12"
                         Foreground="{DynamicResource VelaTextMutedBrush}"
                         VerticalAlignment="Center" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding AmountPresetIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="$42.50" />
                <vela:VelaSegmentedItem Content="$128.00" />
                <vela:VelaSegmentedItem Content="$1,499" />
              </vela:VelaSegmentedControl>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource StrSpeed}"
                         FontSize="12"
                         Foreground="{DynamicResource VelaTextMutedBrush}"
                         VerticalAlignment="Center" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding SpeedIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="0.5×" />
                <vela:VelaSegmentedItem Content="1×" />
                <vela:VelaSegmentedItem Content="1.5×" />
                <vela:VelaSegmentedItem Content="2×" />
              </vela:VelaSegmentedControl>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource StrLoop}"
                         FontSize="12"
                         Foreground="{DynamicResource VelaTextMutedBrush}"
                         VerticalAlignment="Center" />
              <vela:VelaSwitch IsChecked="{Binding IsLooping, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{DynamicResource StrPaymentFlowHint}"
                     FontSize="11.5"
                     Foreground="{DynamicResource VelaTextMutedBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
