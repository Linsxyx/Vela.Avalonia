<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.Views.ActionsPage"
             x:DataType="vm:ActionsViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageRoot">
      <TextBlock Classes="pageTitle" Text="{DynamicResource StrNavActions}" />

      <!-- Row 1: VelaButton + VelaSplitButton / VelaCopyButton -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="VelaButton" />

            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <vela:VelaButton Variant="Primary" Content="{DynamicResource StrPrimary}" />
              <vela:VelaButton Variant="Secondary" Content="{DynamicResource StrSecondary}" />
              <vela:VelaButton Variant="Ghost" Content="{DynamicResource StrGhost}" />
              <vela:VelaButton Variant="Danger" Content="{DynamicResource StrDanger}" />
              <vela:VelaButton Variant="Secondary" Content="{DynamicResource StrDisabled}" IsEnabled="False" />
            </WrapPanel>

            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <vela:VelaButton Variant="Primary"
                               IsLoading="{Binding IsSaving}"
                               Content="{Binding SaveButtonText}"
                               Command="{Binding SaveChangesCommand}" />
              <vela:VelaButton Variant="Secondary" Size="Small" Content="{DynamicResource StrSmall}" />
              <vela:VelaButton Variant="Secondary" Size="Large" Content="{DynamicResource StrLarge}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardTitle" Text="VelaSplitButton &amp; VelaCopyButton" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="statusText" Text="{Binding SplitStatus}" VerticalAlignment="Center" />
            </Grid>

            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
              <vela:VelaSplitButton Variant="Primary"
                                    LeadingIcon="{DynamicResource VelaIconRocket}"
                                    Content="{Binding SplitButtonLabel}"
                                    Command="{Binding ExecuteSplitPrimaryCommand}">
                <vela:VelaMenuItem Header="{DynamicResource StrProduction}" Icon="{DynamicResource VelaIconRocket}" Shortcut="⌘⏎" Click="OnSplitProdClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrStaging}" Icon="{DynamicResource VelaIconGlobe}" Shortcut="⇧⌘⏎" Click="OnSplitStagingClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrDownload}" Icon="{DynamicResource VelaIconDownload}" Click="OnSplitDownloadClick" />
                <vela:VelaMenuItem IsSeparator="True" />
                <vela:VelaMenuItem Header="{DynamicResource StrRollback}" Icon="{DynamicResource VelaIconTrash}" IsDestructive="True" Click="OnSplitRollbackClick" />
              </vela:VelaSplitButton>

              <vela:VelaSplitButton Variant="Secondary"
                                    LeadingIcon="{DynamicResource VelaIconShare}"
                                    Content="{DynamicResource StrShare}"
                                    Command="{Binding SplitShareCommand}">
                <vela:VelaMenuItem Header="{DynamicResource StrCopyLink}" Icon="{DynamicResource VelaIconCopy}" Click="OnSplitCopyLinkClick" />
                <vela:VelaMenuItem Header="{DynamicResource StrExportMd}" Icon="{DynamicResource VelaIconEdit}" Click="OnSplitExportMdClick" />
              </vela:VelaSplitButton>
            </WrapPanel>

            <Border Background="{DynamicResource VelaSurfaceMutedBrush}"
                    BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,6">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="dotnet add package Vela.Avalonia"
                           FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <vela:VelaCopyButton Grid.Column="1"
                                     CopyText="dotnet add package Vela.Avalonia"
                                     IconOnly="True"
                                     Variant="Plain"
                                     Copied="OnCopied" />
              </Grid>
            </Border>

            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
              <vela:VelaCopyButton CopyText="vela_live_9f8a2c4b71e0" Label="{DynamicResource StrCopyApiKey}" Copied="OnCopied" />
              <vela:VelaCopyButton CopyText="Vela.Avalonia 12.2" Label="{DynamicResource StrCopy}" Variant="Plain" Copied="OnCopied" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 2: VelaConfirmMorph + VelaHoldToConfirm -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="VelaConfirmMorph" />

            <StackPanel Spacing="10">
              <vela:VelaConfirmMorph IdleText="{DynamicResource StrDeleteBranch}"
                                     Icon="{DynamicResource VelaIconTrash}"
                                     PromptText="{DynamicResource StrDeleteBranchPrompt}"
                                     ConfirmText="{DynamicResource StrDelete}"
                                     CancelText="{DynamicResource StrCancel}"
                                     BusyText="{DynamicResource StrDeleting}"
                                     DoneText="{DynamicResource StrDeleted}"
                                     UndoText="{DynamicResource StrUndo}"
                                     Confirmed="OnBranchDeleted"
                                     Undone="OnBranchRestored" />

              <vela:VelaConfirmMorph IdleText="{DynamicResource StrPurgeCache}"
                                     PromptText="{DynamicResource StrPurgePrompt}"
                                     ConfirmText="{DynamicResource StrPurge}"
                                     CancelText="{DynamicResource StrCancel}"
                                     BusyText="{DynamicResource StrPurging}"
                                     DoneText="{DynamicResource StrPurged}"
                                     UndoText="{DynamicResource StrRestore}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="cardTitle" Text="VelaHoldToConfirm" VerticalAlignment="Center" />
              <vela:VelaButton Grid.Column="1"
                               Variant="Ghost"
                               Size="Small"
                               Content="{DynamicResource StrReset}"
                               Command="{Binding ResetAllHoldCommand}" />
            </Grid>

            <StackPanel Spacing="8">
              <vela:VelaHoldToConfirm x:Name="HoldDangerBtn"
                                      Tone="Danger"
                                      Label="{DynamicResource StrHoldPurge}"
                                      ConfirmedLabel="{DynamicResource StrPurged}"
                                      DurationMs="1000"
                                      HoldChanged="OnHoldChanged"
                                      Confirmed="OnHoldPurgeConfirmed" />
              <vela:VelaHoldToConfirm x:Name="HoldAccentBtn"
                                      Tone="Accent"
                                      Icon="{DynamicResource VelaIconRocket}"
                                      Label="{DynamicResource StrHoldPublish}"
                                      ConfirmedLabel="{DynamicResource StrPublished}"
                                      DurationMs="1100"
                                      HoldChanged="OnHoldChanged"
                                      Confirmed="OnHoldPublishConfirmed" />
              <vela:VelaHoldToConfirm x:Name="HoldNeutralBtn"
                                      Tone="Neutral"
                                      Icon="{DynamicResource VelaIconShield}"
                                      Label="{DynamicResource StrHoldSeal}"
                                      ConfirmedLabel="{DynamicResource StrSealed}"
                                      DurationMs="900"
                                      HoldChanged="OnHoldChanged"
                                      Confirmed="OnHoldSealConfirmed" />
            </StackPanel>

            <TextBlock Classes="statusText" Text="{Binding HoldStatus}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 3: VelaFloatingBar -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="cardTitle" Text="VelaFloatingBar" />

          <Border CornerRadius="14" Height="104" ClipToBounds="True">
            <Grid>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#7747FF" Offset="0" />
                    <GradientStop Color="#EC4899" Offset="0.52" />
                    <GradientStop Color="#F59E0B" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>

              <vela:VelaFloatingBar x:Name="ShowcaseFloatingBar"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    UseLiquidGlass="True">
                <vela:VelaFloatingBarItem Icon="{DynamicResource VelaIconEdit}" Label="Edit" Click="OnFloatingEditClick" />
                <vela:VelaFloatingBarItem Icon="{DynamicResource VelaIconCopy}" Label="Copy" Click="OnFloatingCopyClick" />
                <vela:VelaFloatingBarItem Icon="{DynamicResource VelaIconShare}" Label="Share" IsToggle="True" />
                <vela:VelaFloatingBarItem IsSeparator="True" />
                <vela:VelaFloatingBarItem Icon="{DynamicResource VelaIconTrash}" ToolTipText="Delete" Click="OnFloatingDeleteClick" />
              </vela:VelaFloatingBar>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
      <!-- Row 4: VelaToolBar -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Classes="cardTitle" Text="VelaToolBar" VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="10" LineSpacing="8" VerticalAlignment="Center">
              <vela:VelaSwitch Content="{DynamicResource StrCompact}" IsChecked="{Binding ToolBarCompact, Mode=TwoWay}" VerticalAlignment="Center" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding ToolBarVariantIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="{DynamicResource StrStandard}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrFloating}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrBorderless}" />
              </vela:VelaSegmentedControl>
            </WrapPanel>
          </Grid>

          <vela:VelaToolBar Variant="{Binding ToolBarVariant}"
                            IsCompact="{Binding ToolBarCompact}">
            <vela:VelaToolBarButton Icon="{DynamicResource VelaIconPlus}"
                                    Label="{DynamicResource StrNewFile}"
                                    Command="{Binding ToolBarActionCommand}"
                                    CommandParameter="new" />
            <vela:VelaToolBarButton Icon="{DynamicResource VelaIconCopy}"
                                    Label="{DynamicResource StrCopy}"
                                    Command="{Binding ToolBarActionCommand}"
                                    CommandParameter="copy" />
            <vela:VelaToolBarSeparator />
            <vela:VelaToolBarToggleButton Icon="{DynamicResource VelaIconTable}"
                                          Label="{DynamicResource StrToggleGrid}"
                                          IsChecked="{Binding ToolBarGridActive, Mode=TwoWay}" />
            <vela:VelaToolBarToggleButton Icon="{DynamicResource VelaIconSidebar}"
                                          Label="{DynamicResource StrInspector}"
                                          IsChecked="{Binding ToolBarInspectorActive, Mode=TwoWay}" />
            <vela:VelaToolBar.TrailingItems>
              <vela:VelaToolBarButton Icon="{DynamicResource VelaIconDownload}"
                                      Label="{DynamicResource StrExport}"
                                      Command="{Binding ToolBarActionCommand}"
                                      CommandParameter="export" />
              <vela:VelaToolBarButton Icon="{DynamicResource VelaIconSettings}"
                                      Command="{Binding ToolBarActionCommand}"
                                      CommandParameter="settings" />
            </vela:VelaToolBar.TrailingItems>
          </vela:VelaToolBar>

          <TextBlock Classes="statusText" Text="{Binding ToolBarStatus}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
