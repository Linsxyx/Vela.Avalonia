<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.Views.OverviewPage"
             x:DataType="vm:MainViewModel"
             x:Name="PageRoot">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageRoot">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="pageTitle" Text="{DynamicResource StrNavOverview}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <vela:VelaButton Variant="Secondary"
                           Size="Small"
                           Content="{DynamicResource StrCmdPaletteBtn}"
                           Command="{Binding OpenCommandPaletteCommand}" />
          <vela:VelaButton Variant="Ghost"
                           Size="Small"
                           Content="{DynamicResource StrClearCache}"
                           Command="{Binding ClearPageCacheCommand}" />
        </StackPanel>
      </Grid>

      <!-- Appearance, Accent & Language -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="cardTitle" Text="{DynamicResource StrAppearance}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
              <vela:VelaSwitch Content="{DynamicResource StrDarkMode}" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
              <vela:VelaSwitch Content="{DynamicResource StrReducedMotion}" IsChecked="{Binding ReducedMotion, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="8">
              <TextBlock Classes="fieldLabel" Text="{DynamicResource StrAccent}" />
              <ItemsControl ItemsSource="{Binding AccentSwatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccentSwatchViewModel">
                    <Button Theme="{DynamicResource VelaIconButtonTheme}"
                            Width="26"
                            Height="26"
                            CornerRadius="999"
                            ToolTip.Tip="{Binding Name}"
                            Command="{Binding #PageRoot.((vm:MainViewModel)DataContext).SelectAccentCommand}"
                            CommandParameter="{Binding Accent}">
                      <Border Width="22"
                              Height="22"
                              CornerRadius="999"
                              Background="{Binding SwatchBrush}"
                              BorderBrush="{Binding RingBrush}"
                              BorderThickness="2" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
              <TextBlock Classes="fieldLabel" Text="{DynamicResource StrLanguage}" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="English" />
                <vela:VelaSegmentedItem Content="中文" />
              </vela:VelaSegmentedControl>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Shell & PageDeck 2-Column Grid -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="{DynamicResource StrNavShell}" />

            <StackPanel Spacing="6">
              <TextBlock Classes="fieldLabel" Text="{DynamicResource StrDisplayMode}" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding DisplayModeIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="{DynamicResource StrLeftSidebar}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrTopNavbar}" />
              </vela:VelaSegmentedControl>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="fieldLabel" Text="{DynamicResource StrSidebarStyle}" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding PaneVariantIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="{DynamicResource StrStandard}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrFloating}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrFrosted}" />
              </vela:VelaSegmentedControl>
            </StackPanel>

            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="10">
              <vela:VelaSwitch Content="{DynamicResource StrExpanded}" IsChecked="{Binding IsPaneOpen, Mode=TwoWay}" />
              <vela:VelaSwitch Content="{DynamicResource StrTopBar}" IsChecked="{Binding ShowTopBar, Mode=TwoWay}" />
              <vela:VelaSwitch Content="{DynamicResource StrSidebarFilter}" IsChecked="{Binding IsSearchVisible, Mode=TwoWay}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="{DynamicResource StrPageDeckPalette}" />

            <StackPanel Spacing="6">
              <TextBlock Classes="fieldLabel" Text="{DynamicResource StrCacheMode}" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding CacheModeIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="KeepAlive" />
                <vela:VelaSegmentedItem Content="LRU (3)" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrNone}" />
              </vela:VelaSegmentedControl>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="fieldLabel" Text="{DynamicResource StrTransitionMode}" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding TransitionModeIndex, Mode=TwoWay}">
                <vela:VelaSegmentedItem Content="{DynamicResource StrInstant}" />
                <vela:VelaSegmentedItem Content="{DynamicResource StrCompositorFade}" />
              </vela:VelaSegmentedControl>
            </StackPanel>

            <vela:VelaSwitch Content="{DynamicResource StrPaletteLiquidGlass}"
                             IsChecked="{Binding CommandPaletteGlass, Mode=TwoWay}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
