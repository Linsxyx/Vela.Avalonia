<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.Views.OverviewPage"
             x:DataType="vm:MainViewModel"
             x:Name="PageRoot">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageRoot">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="pageTitle" Text="Overview" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <vela:VelaButton Variant="Secondary"
                           Size="Small"
                           Content="Command Palette (⌘K)"
                           Command="{Binding OpenCommandPaletteCommand}" />
          <vela:VelaButton Variant="Ghost"
                           Size="Small"
                           Content="Clear Cache"
                           Command="{Binding ClearPageCacheCommand}" />
        </StackPanel>
      </Grid>

      <!-- Appearance & Theme -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="cardTitle" Text="Appearance" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
              <vela:VelaSwitch Content="Dark mode" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
              <vela:VelaSwitch Content="Reduced motion" IsChecked="{Binding ReducedMotion, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="8">
            <TextBlock Classes="fieldLabel" Text="Accent" />
            <ItemsControl ItemsSource="{Binding AccentSwatches}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AccentSwatchViewModel">
                  <Button Theme="{DynamicResource VelaIconButtonTheme}"
                          Width="26"
                          Height="26"
                          CornerRadius="999"
                          ToolTip.Tip="{Binding Name}"
                          Command="{Binding #PageRoot.((vm:MainViewModel)DataContext).SelectAccentCommand}"
                          CommandParameter="{Binding Accent}">
                    <Border Width="22"
                            Height="22"
                            CornerRadius="999"
                            Background="{Binding SwatchBrush}"
                            BorderBrush="{Binding RingBrush}"
                            BorderThickness="2" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Shell & PageDeck 2-Column Grid -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="Navigation Shell" />

            <StackPanel Spacing="6">
              <TextBlock Classes="fieldLabel" Text="Display Mode" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding DisplayModeIndex, Mode=TwoWay}">
                <x:String>Left Sidebar</x:String>
                <x:String>Top Navbar</x:String>
              </vela:VelaSegmentedControl>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="fieldLabel" Text="Sidebar Style" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding PaneVariantIndex, Mode=TwoWay}">
                <x:String>Standard</x:String>
                <x:String>Floating</x:String>
                <x:String>Frosted</x:String>
              </vela:VelaSegmentedControl>
            </StackPanel>

            <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="10">
              <vela:VelaSwitch Content="Expanded" IsChecked="{Binding IsPaneOpen, Mode=TwoWay}" />
              <vela:VelaSwitch Content="Top bar" IsChecked="{Binding ShowTopBar, Mode=TwoWay}" />
              <vela:VelaSwitch Content="Sidebar filter" IsChecked="{Binding IsSearchVisible, Mode=TwoWay}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="VelaPageDeck &amp; Palette" />

            <StackPanel Spacing="6">
              <TextBlock Classes="fieldLabel" Text="PageCacheMode" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding CacheModeIndex, Mode=TwoWay}">
                <x:String>KeepAlive</x:String>
                <x:String>LRU (3)</x:String>
                <x:String>None</x:String>
              </vela:VelaSegmentedControl>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="fieldLabel" Text="PageTransitionMode" />
              <vela:VelaSegmentedControl SelectedIndex="{Binding TransitionModeIndex, Mode=TwoWay}">
                <x:String>Instant</x:String>
                <x:String>Compositor Fade</x:String>
              </vela:VelaSegmentedControl>
            </StackPanel>

            <vela:VelaSwitch Content="Command Palette Liquid Glass"
                             IsChecked="{Binding CommandPaletteGlass, Mode=TwoWay}" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
