<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.Views.InputsPage"
             x:DataType="vm:InputsViewModel">
  <ScrollViewer Classes="pageScroll">
    <StackPanel Classes="pageRoot" ClipToBounds="False">
      <TextBlock Classes="pageTitle" Text="{DynamicResource StrNavInputs}" />

      <!-- Row 1: Text & Tag Inputs -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="cardTitle" Text="VelaInput &amp; VelaTagInput" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="12">
            <vela:VelaInput Label="{DynamicResource StrEmail}"
                            PlaceholderText="you@company.com"
                            LeadingIcon="{DynamicResource VelaIconMail}"
                            IsClearable="True" />

            <vela:VelaInput Grid.Column="1"
                            Label="{DynamicResource StrWorkspaceSlug}"
                            Text="vela-invalid!!"
                            ErrorMessage="{DynamicResource StrSlugError}"
                            IsClearable="True" />

            <vela:VelaInput Grid.Row="1"
                            Label="{DynamicResource StrPassword}"
                            PlaceholderText="{DynamicResource StrPasswordPlaceholder}"
                            PasswordChar="•" />

            <vela:VelaInput Grid.Row="1"
                            Grid.Column="1"
                            Label="{DynamicResource StrDisabled}"
                            Text="{DynamicResource StrReadOnlyPreset}"
                            IsEnabled="False" />
          </Grid>

          <vela:VelaTagInput x:Name="DemoTagInput"
                             Label="{DynamicResource StrTags}"
                             PlaceholderText="{DynamicResource StrAddTagPlaceholder}" />
        </StackPanel>
      </Border>

      <!-- Row 2: Toggles + Segmented -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="cardTitle" Text="VelaSwitch &amp; VelaCheckBox" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <StackPanel Spacing="10">
                <vela:VelaSwitch Content="{DynamicResource StrSpringPhysics}" IsChecked="True" />
                <vela:VelaSwitch Content="{DynamicResource StrGpuComposition}" IsChecked="True" />
                <vela:VelaSwitch Content="{DynamicResource StrAutoSyncTokens}" IsChecked="False" />
                <vela:VelaSwitch Content="{DynamicResource StrDisabled}" IsChecked="True" IsEnabled="False" />
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="10">
                <vela:VelaCheckBox Content="{DynamicResource StrHardwareBlur}" IsChecked="True" />
                <vela:VelaCheckBox Content="{DynamicResource StrTriState}" IsThreeState="True" IsChecked="{x:Null}" />
                <vela:VelaCheckBox Content="{DynamicResource StrReleaseNotes}" IsChecked="False" />
                <vela:VelaCheckBox Content="{DynamicResource StrDisabled}" IsChecked="True" IsEnabled="False" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="VelaSegmentedControl" />

            <vela:VelaSegmentedControl SelectedIndex="{Binding SelectedPlanIndex, Mode=TwoWay}">
              <vela:VelaSegmentedItem Content="{DynamicResource StrMonthly}" />
              <vela:VelaSegmentedItem Content="{DynamicResource StrQuarterly}" />
              <vela:VelaSegmentedItem Content="{DynamicResource StrYearlySave}" />
            </vela:VelaSegmentedControl>

            <TextBlock Classes="statusText" Text="{Binding PlanSummary}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 3: VelaElasticSlider + VelaScrubInput -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16" ClipToBounds="False">
        <Border Classes="card" ClipToBounds="False">
          <StackPanel Spacing="24" ClipToBounds="False">
            <TextBlock Classes="cardTitle" Text="VelaElasticSlider" />

            <vela:VelaElasticSlider Label="{DynamicResource StrMasterVolume}"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    Step="1"
                                    Marks="{Binding VolumeMarks}"
                                    ValueSuffix="%" />

            <vela:VelaElasticSlider Label="{DynamicResource StrCanvasZoom}"
                                    Minimum="0"
                                    Maximum="200"
                                    Value="{Binding CanvasZoom, Mode=TwoWay}"
                                    Step="5"
                                    Marks="{Binding ZoomMarks}"
                                    ValueSuffix="%" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="cardTitle" Text="VelaScrubInput" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
              <vela:VelaScrubInput Label="{DynamicResource StrWidth}" HandleText="W" Value="{Binding ScrubWidth, Mode=TwoWay}" Minimum="0" Maximum="1200" Step="1" Unit="px" />
              <vela:VelaScrubInput Grid.Column="1" Label="{DynamicResource StrRadius}" HandleText="R" Value="{Binding ScrubRadius, Mode=TwoWay}" Minimum="0" Maximum="64" Step="1" Unit="px" />
              <vela:VelaScrubInput Grid.Row="1" Label="{DynamicResource StrOpacity}" HandleText="%" Value="{Binding ScrubOpacity, Mode=TwoWay}" Minimum="0" Maximum="100" Step="1" Unit="%" />
              <vela:VelaScrubInput Grid.Row="1" Grid.Column="1" Label="{DynamicResource StrRotation}" HandleText="∠" Value="{Binding ScrubRotation, Mode=TwoWay}" Minimum="-180" Maximum="180" Step="1" Unit="°" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 4: VelaRulerSlider -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="cardTitle" Text="VelaRulerSlider" />

          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <vela:VelaRulerSlider Label="{DynamicResource StrColorTemp}"
                                  Unit="K"
                                  Minimum="2500"
                                  Maximum="8500"
                                  Step="100"
                                  MajorEvery="10"
                                  TickSpacing="9"
                                  Value="{Binding ColorTemperature, Mode=TwoWay}"
                                  FormatString="0" />

            <vela:VelaRulerSlider Grid.Column="1"
                                  Label="{DynamicResource StrZoom}"
                                  Unit="%"
                                  Minimum="25"
                                  Maximum="200"
                                  Step="5"
                                  MajorEvery="5"
                                  TickSpacing="10"
                                  Value="{Binding RulerZoom, Mode=TwoWay}"
                                  FormatString="0" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
