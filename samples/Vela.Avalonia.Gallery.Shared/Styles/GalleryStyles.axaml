<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="ScrollViewer.pageScroll">
    <Setter Property="Padding" Value="28,22" />
  </Style>

  <Style Selector="StackPanel.pageRoot">
    <Setter Property="Spacing" Value="18" />
    <Setter Property="MaxWidth" Value="960" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource VelaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.statusText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
</Styles>
