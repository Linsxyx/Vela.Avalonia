<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource VelaBackgroundBrush}"
             Foreground="{DynamicResource VelaForegroundBrush}"
             FontFamily="Inter, sans-serif">

  <Grid>
    <vela:VelaCommandPalette x:Name="CommandPalette"
                             EnableGlobalShortcut="True"
                             UseLiquidGlass="{Binding CommandPaletteGlass}">
      <vela:VelaDrawerHost x:Name="DrawerHost">
        <vela:VelaDialogHost x:Name="DialogHost">
          <DockPanel>
            <!-- Compact Telemetry Status Bar -->
            <Border DockPanel.Dock="Bottom"
                    Height="30"
                    Background="{DynamicResource VelaSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border x:Name="TelemetryDot"
                          Width="7"
                          Height="7"
                          CornerRadius="99"
                          Background="{DynamicResource VelaSuccessBrush}" />
                  <TextBlock Text="{Binding TelemetryText}"
                             FontSize="11.5"
                             Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding TelemetrySummary}"
                           FontSize="11.5"
                           Foreground="{DynamicResource VelaTextMutedBrush}"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>

            <vela:VelaNavigationView x:Name="RootNav"
                                     DisplayMode="{Binding DisplayMode}"
                                     PaneVariant="{Binding PaneVariant}"
                                     ShowTopBar="{Binding ShowTopBar}"
                                     BrandTitle="Vela Studio"
                                     IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                                     IsSearchVisible="{Binding IsSearchVisible}"
                                     PageCacheMode="{Binding PageCacheMode}"
                                     MaxCachedPages="3"
                                     PageTransitionMode="{Binding PageTransitionMode}"
                                     SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                                     PageSwitched="OnPageSwitched">
              <!-- Brand Header (Expanded) -->
              <vela:VelaNavigationView.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Border Width="28"
                          Height="28"
                          CornerRadius="8"
                          Background="{DynamicResource VelaForegroundBrush}">
                    <TextBlock Text="V"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource VelaBackgroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Vela Studio"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VelaForegroundBrush}" />
                    <TextBlock Text="Avalonia 12.2"
                               FontSize="11"
                               Foreground="{DynamicResource VelaTextMutedBrush}" />
                  </StackPanel>
                </StackPanel>
              </vela:VelaNavigationView.Header>

              <!-- Compact Emblem -->
              <vela:VelaNavigationView.CompactHeader>
                <Border Width="28"
                        Height="28"
                        CornerRadius="8"
                        Background="{DynamicResource VelaForegroundBrush}">
                  <TextBlock Text="V"
                             FontSize="13.5"
                             FontWeight="Bold"
                             Foreground="{DynamicResource VelaBackgroundBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </vela:VelaNavigationView.CompactHeader>

              <!-- Top Bar Trailing Slot -->
              <vela:VelaNavigationView.TopBarContent>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Button Theme="{DynamicResource VelaIconButtonTheme}"
                          Background="{DynamicResource VelaSurfaceMutedBrush}"
                          BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Height="28"
                          Padding="10,0"
                          Command="{Binding OpenCommandPaletteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <PathIcon Width="12"
                                Height="12"
                                Data="{DynamicResource VelaIconSearch}"
                                Foreground="{DynamicResource VelaTextMutedBrush}" />
                      <TextBlock Text="Search..."
                                 FontSize="12"
                                 Foreground="{DynamicResource VelaTextMutedBrush}"
                                 VerticalAlignment="Center" />
                      <Border CornerRadius="4"
                              Padding="4,1"
                              Background="{DynamicResource VelaSurfaceBrush}"
                              BorderBrush="{DynamicResource VelaBorderBrush}"
                              BorderThickness="1">
                        <TextBlock Text="⌘K"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                      </Border>
                    </StackPanel>
                  </Button>

                  <vela:VelaAvatarGroup MaxVisible="3" Size="Small" Overlap="8">
                    <vela:VelaAvatar DisplayName="Emma Collins" Tone="Rose" />
                    <vela:VelaAvatar DisplayName="Marcus Chen" Tone="Teal" />
                    <vela:VelaAvatar DisplayName="Kenji Sato" Tone="Violet" />
                    <vela:VelaAvatar DisplayName="Ada Lovelace" Tone="Sky" />
                  </vela:VelaAvatarGroup>
                </StackPanel>
              </vela:VelaNavigationView.TopBarContent>

              <!-- Footer Utility Nav Item -->
              <vela:VelaNavigationView.FooterItems>
                <vela:VelaNavItem Tag="stress"
                                  Header="Stress Test"
                                  Category="Benchmark 500 Nodes PageDeck"
                                  Icon="{DynamicResource VelaIconTrendingUp}"
                                  Badge="500" />
              </vela:VelaNavigationView.FooterItems>

              <!-- Profile & Theme Footer (Expanded) -->
              <vela:VelaNavigationView.Footer>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="4,0">
                  <vela:VelaAvatar DisplayName="Emma Collins" Size="Small" Tone="Accent" Status="Online" />
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Emma Collins"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VelaForegroundBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Designer"
                               FontSize="11"
                               Foreground="{DynamicResource VelaTextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <vela:VelaSwitch Grid.Column="2"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Dark Mode"
                                   IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                </Grid>
              </vela:VelaNavigationView.Footer>

              <!-- Compact Footer -->
              <vela:VelaNavigationView.CompactFooter>
                <vela:VelaAvatar DisplayName="Emma Collins" Size="Small" Tone="Accent" Status="Online" />
              </vela:VelaNavigationView.CompactFooter>

              <!-- Core -->
              <vela:VelaNavItem Tag="overview"
                                Header="Overview"
                                Category="Shell Theme Accent Cache CommandPalette"
                                Icon="{DynamicResource VelaIconCompass}" />

              <!-- Components Tree -->
              <vela:VelaNavSectionHeader Header="Components" />

              <vela:VelaNavItem Header="Controls"
                                Icon="{DynamicResource VelaIconFolder}"
                                IsExpanded="True">
                <vela:VelaNavItem Tag="actions"
                                  Header="Actions"
                                  Category="Button Split Copy ConfirmMorph HoldToConfirm FloatingBar"
                                  Icon="{DynamicResource VelaIconComponents}" />
                <vela:VelaNavItem Tag="inputs"
                                  Header="Inputs &amp; Sliders"
                                  Category="Input TagInput Switch CheckBox Segmented ElasticSlider ScrubInput RulerSlider"
                                  Icon="{DynamicResource VelaIconSliders}" />
                <vela:VelaNavItem Tag="pickers"
                                  Header="Pickers &amp; Menus"
                                  Category="RadioCards Select ComboBox DatePicker Calendar Dropdown Popover ContextMenu ColorPicker"
                                  Icon="{DynamicResource VelaIconCalendar}" />
                <vela:VelaNavItem Tag="layout"
                                  Header="Navigation &amp; Layout"
                                  Category="DockBar Tabs Stepper Breadcrumb Pagination Accordion ResizablePanels"
                                  Icon="{DynamicResource VelaIconLayers}" />
                <vela:VelaNavItem Tag="feedback"
                                  Header="Overlays &amp; Feedback"
                                  Category="Dialog Drawer Toast BusyOverlay Progress Skeleton Alert"
                                  Icon="{DynamicResource VelaIconBell}" />
                <vela:VelaNavItem Tag="display"
                                  Header="Data Display"
                                  Category="MetricCard Counter Avatar Badge SettingsGroup EmptyState"
                                  Icon="{DynamicResource VelaIconHome}" />
              </vela:VelaNavItem>

              <!-- Studio & Labs -->
              <vela:VelaNavSectionHeader Header="Studio" />

              <vela:VelaNavItem Tag="shaders"
                                Header="Shaders &amp; Glass"
                                Category="LiquidGlass ShaderBackground Blur Refraction Skia"
                                Icon="{DynamicResource VelaIconSparkles}"
                                Badge="GPU" />
              <vela:VelaNavItem Tag="charts"
                                Header="Charts"
                                Category="Line Bar Donut Gauge Sparkline Heatmap"
                                Icon="{DynamicResource VelaIconChart}"
                                Badge="6" />
              <vela:VelaNavItem Tag="tray"
                                Header="System Tray"
                                Category="TrayIcon NativeMenu Flyout Popover Badge Progress"
                                Icon="{DynamicResource VelaIconBell}" />
            </vela:VelaNavigationView>
          </DockPanel>
        </vela:VelaDialogHost>
      </vela:VelaDrawerHost>
    </vela:VelaCommandPalette>

    <vela:VelaToastHost x:Name="ToastHost" />
  </Grid>
</UserControl>
