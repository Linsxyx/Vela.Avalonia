<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:vm="using:Vela.Avalonia.Gallery.ViewModels"
             x:Class="Vela.Avalonia.Gallery.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource VelaBackgroundBrush}"
             Foreground="{DynamicResource VelaForegroundBrush}"
             FontFamily="Inter, PingFang SC, Microsoft YaHei UI, sans-serif">

  <Grid>
    <vela:VelaCommandPalette x:Name="CommandPalette"
                             EnableGlobalShortcut="True"
                             UseLiquidGlass="{Binding CommandPaletteGlass}">
      <vela:VelaDrawerHost x:Name="DrawerHost">
        <vela:VelaDialogHost x:Name="DialogHost">
          <DockPanel>
            <!-- Compact Telemetry Status Bar -->
            <Border DockPanel.Dock="Bottom"
                    Height="30"
                    Background="{DynamicResource VelaSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border x:Name="TelemetryDot"
                          Width="7"
                          Height="7"
                          CornerRadius="99"
                          Background="{DynamicResource VelaSuccessBrush}" />
                  <TextBlock Text="{Binding TelemetryText}"
                             FontSize="11.5"
                             Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding TelemetrySummary}"
                           FontSize="11.5"
                           Foreground="{DynamicResource VelaTextMutedBrush}"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>

            <vela:VelaNavigationView x:Name="RootNav"
                                     DisplayMode="{Binding DisplayMode}"
                                     PaneVariant="{Binding PaneVariant}"
                                     ShowTopBar="{Binding ShowTopBar}"
                                     BrandTitle="{DynamicResource StrBrandTitle}"
                                     IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                                     IsSearchVisible="{Binding IsSearchVisible}"
                                     PageCacheMode="{Binding PageCacheMode}"
                                     MaxCachedPages="3"
                                     PageTransitionMode="{Binding PageTransitionMode}"
                                     SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                                     PageSwitched="OnPageSwitched">
              <!-- Brand Header (Expanded) -->
              <vela:VelaNavigationView.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Image Source="avares://Vela.Avalonia.Gallery.Shared/Assets/vela-icon.png"
                         Width="28" Height="28" />
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource StrBrandTitle}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VelaForegroundBrush}" />
                    <TextBlock Text="Avalonia 12.2"
                               FontSize="11"
                               Foreground="{DynamicResource VelaTextMutedBrush}" />
                  </StackPanel>
                </StackPanel>
              </vela:VelaNavigationView.Header>

              <!-- Compact Emblem -->
              <vela:VelaNavigationView.CompactHeader>
                <Image Source="avares://Vela.Avalonia.Gallery.Shared/Assets/vela-icon.png"
                       Width="28" Height="28" />
              </vela:VelaNavigationView.CompactHeader>

              <!-- Top Bar Trailing Slot: Language Toggle + Search Pill + Avatars -->
              <vela:VelaNavigationView.TopBarContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Theme="{DynamicResource VelaIconButtonTheme}"
                          Background="{DynamicResource VelaSurfaceMutedBrush}"
                          BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Height="28"
                          Padding="9,0"
                          ToolTip.Tip="{DynamicResource StrLangToggleTip}"
                          Command="{Binding ToggleLanguageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <PathIcon Width="12"
                                Height="12"
                                Data="{DynamicResource VelaIconGlobe}"
                                Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                      <TextBlock Text="{DynamicResource StrLangToggleLabel}"
                                 FontSize="11.5"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource VelaForegroundBrush}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Theme="{DynamicResource VelaIconButtonTheme}"
                          Background="{DynamicResource VelaSurfaceMutedBrush}"
                          BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Height="28"
                          Padding="10,0"
                          Command="{Binding OpenCommandPaletteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <PathIcon Width="12"
                                Height="12"
                                Data="{DynamicResource VelaIconSearch}"
                                Foreground="{DynamicResource VelaTextMutedBrush}" />
                      <TextBlock Text="{DynamicResource StrSearch}"
                                 FontSize="12"
                                 Foreground="{DynamicResource VelaTextMutedBrush}"
                                 VerticalAlignment="Center" />
                      <Border CornerRadius="4"
                              Padding="4,1"
                              Background="{DynamicResource VelaSurfaceBrush}"
                              BorderBrush="{DynamicResource VelaBorderBrush}"
                              BorderThickness="1">
                        <TextBlock Text="⌘K"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                      </Border>
                    </StackPanel>
                  </Button>

                  <vela:VelaAvatarGroup MaxVisible="3" Size="Small" Overlap="8">
                    <vela:VelaAvatar DisplayName="Emma Collins" Tone="Rose" />
                    <vela:VelaAvatar DisplayName="Marcus Chen" Tone="Teal" />
                    <vela:VelaAvatar DisplayName="Kenji Sato" Tone="Violet" />
                    <vela:VelaAvatar DisplayName="Ada Lovelace" Tone="Sky" />
                  </vela:VelaAvatarGroup>
                </StackPanel>
              </vela:VelaNavigationView.TopBarContent>

              <!-- Footer Utility Nav Item -->
              <vela:VelaNavigationView.FooterItems>
                <vela:VelaNavItem Tag="stress"
                                  Header="{DynamicResource StrNavStress}"
                                  Category="Benchmark 500 Nodes PageDeck 压力测试"
                                  Icon="{DynamicResource VelaIconTrendingUp}"
                                  Badge="500" />
              </vela:VelaNavigationView.FooterItems>

              <!-- Profile & Theme Footer (Expanded) -->
              <vela:VelaNavigationView.Footer>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="4,0">
                  <vela:VelaAvatar DisplayName="Emma Collins" Size="Small" Tone="Accent" Status="Online" />
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Emma Collins"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VelaForegroundBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{DynamicResource StrRoleDesigner}"
                               FontSize="11"
                               Foreground="{DynamicResource VelaTextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <vela:VelaSwitch Grid.Column="2"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{DynamicResource StrDarkModeTip}"
                                   IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                </Grid>
              </vela:VelaNavigationView.Footer>

              <!-- Compact Footer -->
              <vela:VelaNavigationView.CompactFooter>
                <vela:VelaAvatar DisplayName="Emma Collins" Size="Small" Tone="Accent" Status="Online" />
              </vela:VelaNavigationView.CompactFooter>

              <!-- Core -->
              <vela:VelaNavItem Tag="overview"
                                Header="{DynamicResource StrNavOverview}"
                                Category="Shell Theme Accent Cache CommandPalette 概览 外观 语言"
                                Icon="{DynamicResource VelaIconCompass}" />

              <!-- Components Tree -->
              <vela:VelaNavSectionHeader Header="{DynamicResource StrSecComponents}" />

              <vela:VelaNavItem Header="{DynamicResource StrNavControls}"
                                Icon="{DynamicResource VelaIconFolder}"
                                IsExpanded="True">
                <vela:VelaNavItem Tag="actions"
                                  Header="{DynamicResource StrNavActions}"
                                  Category="Button Split Copy ConfirmMorph HoldToConfirm FloatingBar 按钮 操作"
                                  Icon="{DynamicResource VelaIconComponents}" />
                <vela:VelaNavItem Tag="inputs"
                                  Header="{DynamicResource StrNavInputs}"
                                  Category="Input TagInput Switch CheckBox Segmented ElasticSlider ScrubInput RulerSlider 输入 滑块"
                                  Icon="{DynamicResource VelaIconSliders}" />
                <vela:VelaNavItem Tag="pickers"
                                  Header="{DynamicResource StrNavPickers}"
                                  Category="RadioCards Select ComboBox DatePicker Calendar Dropdown Popover ContextMenu ColorPicker 选择 菜单 日历 颜色"
                                  Icon="{DynamicResource VelaIconCalendar}" />
                <vela:VelaNavItem Tag="layout"
                                  Header="{DynamicResource StrNavLayout}"
                                  Category="DockBar Tabs Stepper Breadcrumb Pagination Accordion ResizablePanels 导航 布局 分页 步骤"
                                  Icon="{DynamicResource VelaIconLayers}" />
                <vela:VelaNavItem Tag="feedback"
                                  Header="{DynamicResource StrNavFeedback}"
                                  Category="Dialog Drawer Toast BusyOverlay Progress Skeleton Alert 弹窗 抽屉 通知 进度"
                                  Icon="{DynamicResource VelaIconBell}" />
                <vela:VelaNavItem Tag="display"
                                  Header="{DynamicResource StrNavDisplay}"
                                  Category="MetricCard Counter Avatar Badge SettingsGroup EmptyState 指标 头像 徽章 设置"
                                  Icon="{DynamicResource VelaIconHome}" />
                <vela:VelaNavItem Tag="dataviews"
                                  Header="{DynamicResource StrNavDataViews}"
                                  Category="TreeView DataGrid TreeTable Table Tree Sort Resize 树 表格 数据表格 树形表格"
                                  Icon="{DynamicResource VelaIconTable}"
                                  Badge="3" />
              </vela:VelaNavItem>

              <!-- Studio & Labs -->
              <vela:VelaNavSectionHeader Header="{DynamicResource StrSecStudio}" />

              <vela:VelaNavItem Tag="shaders"
                                Header="{DynamicResource StrNavShaders}"
                                Category="LiquidGlass ShaderBackground Blur Refraction Skia 着色器 液态玻璃"
                                Icon="{DynamicResource VelaIconSparkles}"
                                Badge="GPU" />
              <vela:VelaNavItem Tag="charts"
                                Header="{DynamicResource StrNavCharts}"
                                Category="Line Bar Donut Gauge Sparkline Heatmap 图表"
                                Icon="{DynamicResource VelaIconChart}"
                                Badge="6" />
              <vela:VelaNavItem Tag="tray"
                                Header="{DynamicResource StrNavTray}"
                                Category="TrayIcon NativeMenu Flyout Popover Badge Progress 托盘"
                                Icon="{DynamicResource VelaIconBell}" />
            </vela:VelaNavigationView>
          </DockPanel>
        </vela:VelaDialogHost>
      </vela:VelaDrawerHost>
    </vela:VelaCommandPalette>

    <vela:VelaToastHost x:Name="ToastHost" />
  </Grid>
</UserControl>
