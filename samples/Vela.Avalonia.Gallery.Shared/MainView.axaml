<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vela="using:Vela.Avalonia.Controls"
             xmlns:charts="using:Vela.Avalonia.Charts"
             x:Class="Vela.Avalonia.Gallery.MainView"
             Background="{DynamicResource VelaBackgroundBrush}"
             Foreground="{DynamicResource VelaForegroundBrush}"
             FontFamily="Inter, sans-serif">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.cardDesc">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <vela:VelaCommandPalette x:Name="CommandPalette" EnableGlobalShortcut="True">
      <vela:VelaDrawerHost x:Name="DrawerHost">
        <vela:VelaDialogHost x:Name="DialogHost">
          <DockPanel>
    <!-- Live Page-Switch Performance Telemetry Bar -->
    <Border DockPanel.Dock="Bottom"
            Height="32"
            Background="{DynamicResource VelaSidebarBackgroundBrush}"
            BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border x:Name="TelemetryDot"
                  Width="7"
                  Height="7"
                  CornerRadius="99"
                  Background="{DynamicResource VelaSuccessBrush}" />
          <TextBlock x:Name="TelemetryText"
                     Text="Ready · PageCacheMode: KeepAlive · Transition: Instant"
                     FontSize="12"
                     Foreground="{DynamicResource VelaTextSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="TelemetryHint"
                   Grid.Column="2"
                   Text="Tip: Visit Heavy Stress (500 nodes) and compare KeepAlive vs None"
                   FontSize="12"
                   Foreground="{DynamicResource VelaTextMutedBrush}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <vela:VelaNavigationView x:Name="RootNav"
                             DisplayMode="Left"
                             IsPaneOpen="True"
                             IsSearchVisible="False"
                             PageCacheMode="KeepAlive"
                             MaxCachedPages="4"
                             PageTransitionMode="Instant"
                             SelectedIndex="0"
                             PageSwitched="OnPageSwitched">
      <!-- Quiet, minimal brand header -->
      <vela:VelaNavigationView.Header>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Vela" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="12.2" FontSize="12" Foreground="{DynamicResource VelaTextMutedBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </vela:VelaNavigationView.Header>

      <!-- Quiet minimal footer -->
      <vela:VelaNavigationView.Footer>
        <vela:VelaSwitch x:Name="DarkModeSwitch"
                         Content="Dark mode"
                         Margin="4,0"
                         IsCheckedChanged="OnDarkModeChanged" />
      </vela:VelaNavigationView.Footer>

      <!-- Page 1: Navigation Performance & Settings -->
      <vela:VelaNavItem Header="Navigation"
                        Category="Performance Shell Cache"
                        Icon="{DynamicResource VelaIconCompass}">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="20" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Navigation &amp; Switching Performance" />
                <TextBlock Classes="pageSubtitle"
                           Text="Restrained monochrome chrome backed by VelaPageDeck: lazy page instantiation, O(1) KeepAlive/LRU visual-tree caching, zero idle Measure/Arrange on hidden pages, and optional render-thread Compositor fades." />
              </StackPanel>

              <Border Classes="card">
                <StackPanel Spacing="18">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="cardTitle" Text="Page Switching Engine" />
                    <TextBlock Classes="cardDesc"
                               Text="Switch cache policy and transition mode, then bounce between tabs (especially Heavy Stress) while watching the bottom latency bar." />
                  </StackPanel>

                  <WrapPanel Orientation="Horizontal" ItemSpacing="24" LineSpacing="16">
                    <StackPanel Spacing="8">
                      <TextBlock Text="PageCacheMode" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource VelaTextMutedBrush}" />
                      <vela:VelaSegmentedControl x:Name="CacheModeSegmented"
                                                 SelectedIndex="0"
                                                 SelectionChanged="OnCacheModeChanged">
                        <x:String>KeepAlive</x:String>
                        <x:String>LRU (Max 3)</x:String>
                        <x:String>None (Rebuild)</x:String>
                      </vela:VelaSegmentedControl>
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="PageTransitionMode" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource VelaTextMutedBrush}" />
                      <vela:VelaSegmentedControl x:Name="TransitionModeSegmented"
                                                 SelectedIndex="0"
                                                 SelectionChanged="OnTransitionModeChanged">
                        <x:String>Instant (0ms)</x:String>
                        <x:String>Compositor Fade</x:String>
                      </vela:VelaSegmentedControl>
                    </StackPanel>
                  </WrapPanel>

                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <vela:VelaButton Variant="Secondary"
                                     Size="Small"
                                     Content="Clear Inactive Cache"
                                     Click="OnClearCacheClick" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="16">
                  <TextBlock Classes="cardTitle" Text="Layout &amp; Appearance" />

                  <WrapPanel Orientation="Horizontal" ItemSpacing="24" LineSpacing="14">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Display Mode" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource VelaTextMutedBrush}" />
                      <vela:VelaSegmentedControl x:Name="DisplayModeSegmented"
                                                 SelectedIndex="0"
                                                 SelectionChanged="OnDisplayModeChanged">
                        <x:String>Left Sidebar</x:String>
                        <x:String>Top Navbar</x:String>
                      </vela:VelaSegmentedControl>
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Text="Options" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource VelaTextMutedBrush}" />
                      <StackPanel Orientation="Horizontal" Spacing="16">
                        <vela:VelaSwitch x:Name="PaneOpenSwitch"
                                         Content="Expanded"
                                         IsChecked="True"
                                         IsCheckedChanged="OnPaneOpenSwitchChanged" />
                        <vela:VelaSwitch x:Name="SearchVisibleSwitch"
                                         Content="Search filter"
                                         IsChecked="False"
                                         IsCheckedChanged="OnSearchVisibleChanged" />
                        <vela:VelaSwitch x:Name="ReducedMotionSwitch"
                                         Content="Reduced motion"
                                         IsCheckedChanged="OnReducedMotionChanged" />
                      </StackPanel>
                    </StackPanel>
                  </WrapPanel>

                  <StackPanel Spacing="8">
                    <TextBlock Text="Accent (Controls &amp; Charts)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource VelaTextMutedBrush}" />
                    <StackPanel x:Name="AccentSwatchesPanel" Orientation="Horizontal" Spacing="8" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 2: Flagship Interactions (Phase 5!) -->
      <vela:VelaNavItem Header="Flagship Lab"
                        Category="CommandPalette FloatingBar Tabs ConfirmMorph ScrubInput"
                        Icon="{DynamicResource VelaIconHome}"
                        Badge="⌘K">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="20" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Flagship Desktop Interactions" />
                <TextBlock Classes="pageSubtitle"
                           Text="Signature Arc motion + Liquid Glass controls: ⌘K Command Palette, Liquid Glass FloatingBar, O(1) Cached Tabs, ConfirmMorph pill, and Figma-style ScrubInput." />
              </StackPanel>

              <!-- VelaCommandPalette Card -->
              <Border Classes="card">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="cardTitle" Text="VelaCommandPalette (⌘K / Ctrl+K)" />
                      <TextBlock Classes="cardDesc"
                                 Text="Press ⌘K (or Ctrl+K) anywhere in this app to search &amp; jump between pages, toggle Dark mode, or run actions." />
                    </StackPanel>
                    <vela:VelaSwitch x:Name="PaletteGlassSwitch"
                                     Grid.Column="1"
                                     Content="Liquid Glass mode"
                                     IsCheckedChanged="OnPaletteGlassModeChanged" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <vela:VelaButton Variant="Primary" Size="Small" Content="Open Command Palette (⌘K)" Click="OnOpenCommandPaletteClick" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- VelaFloatingBar (Liquid Glass Toolbar over gradient backdrop) -->
              <Border Classes="card">
                <StackPanel Spacing="14">
                  <TextBlock Classes="cardTitle" Text="VelaFloatingBar (Liquid Glass + Gliding Highlight)" />
                  <TextBlock Classes="cardDesc"
                             Text="Hover across buttons to watch ONE shared highlight pill glide across the floating glass tray." />

                  <Border CornerRadius="16" Height="112" ClipToBounds="True">
                    <Grid>
                      <Border>
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#7747FF" Offset="0" />
                            <GradientStop Color="#EC4899" Offset="0.52" />
                            <GradientStop Color="#F59E0B" Offset="1" />
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>

                      <vela:VelaFloatingBar HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            UseLiquidGlass="True">
                        <vela:VelaFloatingBarItem Icon="{DynamicResource VelaIconEdit}" Label="Edit" Click="OnFloatingEditClick" />
                        <vela:VelaFloatingBarItem Icon="{DynamicResource VelaIconCopy}" Label="Copy" Click="OnFloatingCopyClick" />
                        <vela:VelaFloatingBarItem Icon="{DynamicResource VelaIconShare}" Label="Share" IsToggle="True" />
                        <vela:VelaFloatingBarItem IsSeparator="True" />
                        <vela:VelaFloatingBarItem Icon="{DynamicResource VelaIconTrash}" ToolTipText="Delete item" Click="OnFloatingDeleteClick" />
                      </vela:VelaFloatingBar>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- VelaConfirmMorph + VelaScrubInput Row -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaConfirmMorph" />
                    <TextBlock Classes="cardDesc"
                               Text="In-place destructive confirmation pill: click Delete → springs open to Confirm/Cancel → Busy spinner → Done with Undo." />

                    <StackPanel Spacing="12">
                      <vela:VelaConfirmMorph IdleText="Delete branch"
                                             Icon="{DynamicResource VelaIconTrash}"
                                             PromptText="Delete main-v2?"
                                             ConfirmText="Delete"
                                             CancelText="Cancel"
                                             BusyText="Deleting..."
                                             DoneText="Branch deleted"
                                             UndoText="Undo"
                                             Confirmed="OnBranchDeleted"
                                             Undone="OnBranchRestored" />

                      <vela:VelaConfirmMorph IdleText="Purge cache"
                                             PromptText="Clear all cached pages?"
                                             ConfirmText="Purge"
                                             BusyText="Purging..."
                                             DoneText="Cache purged"
                                             UndoText="Restore" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaScrubInput (Figma-style)" />
                    <TextBlock Classes="cardDesc"
                               Text="Drag the handle (X / W / Opacity) horizontally, strain past limits, or type arithmetic like 120+40." />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                      <vela:VelaScrubInput Label="Width" HandleText="W" Value="320" Minimum="0" Maximum="1200" Step="1" Unit="px" />
                      <vela:VelaScrubInput Grid.Column="1" Label="Corner Radius" HandleText="R" Value="18" Minimum="0" Maximum="64" Step="1" Unit="px" />
                      <vela:VelaScrubInput Grid.Row="1" Label="Opacity" HandleText="%" Value="85" Minimum="0" Maximum="100" Step="1" Unit="%" />
                      <vela:VelaScrubInput Grid.Row="1" Grid.Column="1" Label="Rotation" HandleText="∠" Value="0" Minimum="-180" Maximum="180" Step="1" Unit="°" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- VelaTabs (Pill & Underline variants powered by VelaPageDeck) -->
              <Border Classes="card">
                <StackPanel Spacing="18">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="cardTitle" Text="VelaTabs (Powered by VelaPageDeck)" />
                      <TextBlock Classes="cardDesc"
                                 Text="Gliding indicator with O(1) KeepAlive tab caching. Toggle between Pill and Underline variants." />
                    </StackPanel>
                    <vela:VelaSegmentedControl x:Name="TabsVariantSegmented"
                                               Grid.Column="1"
                                               SelectedIndex="0"
                                               SelectionChanged="OnTabsVariantChanged">
                      <x:String>Pill</x:String>
                      <x:String>Underline</x:String>
                    </vela:VelaSegmentedControl>
                  </Grid>

                  <vela:VelaTabs x:Name="DemoTabs" Variant="Pill" SelectedIndex="0">
                    <vela:VelaTabItem Header="Overview" Icon="{DynamicResource VelaIconHome}">
                      <vela:VelaTabItem.PageContent>
                        <Border Background="{DynamicResource VelaSurfaceMutedBrush}" CornerRadius="12" Padding="16">
                          <TextBlock Text="Overview panel — cached in VelaPageDeck. Switch tabs and notice instant 0ms return with state preserved."
                                     TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                        </Border>
                      </vela:VelaTabItem.PageContent>
                    </vela:VelaTabItem>
                    <vela:VelaTabItem Header="Activity" Icon="{DynamicResource VelaIconBell}" Badge="12">
                      <vela:VelaTabItem.PageContent>
                        <Border Background="{DynamicResource VelaSurfaceMutedBrush}" CornerRadius="12" Padding="16">
                          <StackPanel Spacing="8">
                            <TextBlock Text="Recent Activity (Stateful Tab)" FontWeight="SemiBold" FontSize="13.5" />
                            <vela:VelaCheckBox Content="Toggle me, switch tabs, and come back — state stays alive!" IsChecked="False" />
                          </StackPanel>
                        </Border>
                      </vela:VelaTabItem.PageContent>
                    </vela:VelaTabItem>
                    <vela:VelaTabItem Header="Settings" Icon="{DynamicResource VelaIconSliders}">
                      <vela:VelaTabItem.PageContent>
                        <Border Background="{DynamicResource VelaSurfaceMutedBrush}" CornerRadius="12" Padding="16">
                          <TextBlock Text="Settings panel — zero visual-tree teardown when switching between VelaTabItems."
                                     TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                        </Border>
                      </vela:VelaTabItem.PageContent>
                    </vela:VelaTabItem>
                  </vela:VelaTabs>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 3: Liquid Glass Lab (Native Avalonia 12.2 BackdropEffect + Clean-Room MIT SkSL Refraction!) -->
      <vela:VelaNavItem Header="Liquid Glass"
                        Category="Shader Glass Blur Refraction Skia"
                        Icon="{DynamicResource VelaIconSparkles}"
                        Badge="GPU">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="20" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="VelaLiquidGlass (GPU Optical Shader)" />
                <TextBlock Classes="pageSubtitle"
                           Text="Clean-room MIT implementation combining Avalonia 12.2's native BackdropEffect blur with an original SkSL rounded-box SDF lens refraction, chromatic dispersion, and Fresnel specular rim shader. Drag the glass pill across the stripes and shapes below." />
              </StackPanel>

              <!-- Interactive Optical Stage -->
              <Border CornerRadius="20"
                      BorderBrush="{DynamicResource VelaBorderBrush}"
                      BorderThickness="1"
                      ClipToBounds="True"
                      Height="340">
                <Grid>
                  <!-- Colorful high-contrast background scene to make optical refraction unmistakable -->
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#EEF2FF" Offset="0" />
                        <GradientStop Color="#FCE7F3" Offset="0.48" />
                        <GradientStop Color="#FEF3C7" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>

                  <!-- Geometric color orbs & sharp typography behind the glass -->
                  <Canvas IsHitTestVisible="False">
                    <Ellipse Canvas.Left="46" Canvas.Top="28" Width="170" Height="170" Fill="#FF7747FF" Opacity="0.82" />
                    <Ellipse Canvas.Left="210" Canvas.Top="135" Width="190" Height="190" Fill="#FF0562EF" Opacity="0.72" />
                    <Ellipse Canvas.Left="430" Canvas.Top="24" Width="160" Height="160" Fill="#FFEC4899" Opacity="0.75" />
                    <Ellipse Canvas.Left="580" Canvas.Top="120" Width="210" Height="210" Fill="#FF0DB879" Opacity="0.70" />
                    <Border Canvas.Left="120" Canvas.Top="64" Width="620" Height="12" CornerRadius="6" Background="#FF18181B" Opacity="0.82" />
                    <Border Canvas.Left="120" Canvas.Top="96" Width="540" Height="12" CornerRadius="6" Background="#FFF59E0B" Opacity="0.92" />
                    <Border Canvas.Left="120" Canvas.Top="128" Width="580" Height="12" CornerRadius="6" Background="#FF18181B" Opacity="0.82" />
                    <TextBlock Canvas.Left="84" Canvas.Top="186"
                               Text="LIQUID GLASS · REFRACTION"
                               FontSize="44"
                               FontWeight="Bold"
                               Foreground="#FF18181B"
                               Opacity="0.86" />
                    <TextBlock Canvas.Left="88" Canvas.Top="244"
                               Text="Drag the pill over these stripes &amp; letters to inspect edge bending and prism dispersion."
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="#FF27272A" />
                  </Canvas>

                  <!-- Draggable Liquid Glass Pill + Floating Glass Toolbar -->
                  <Canvas x:Name="GlassStageCanvas">
                    <vela:VelaLiquidGlass x:Name="DraggableGlassPill"
                                          Canvas.Left="260"
                                          Canvas.Top="78"
                                          Width="270"
                                          Height="112"
                                          CornerRadius="56"
                                          BlurRadius="4"
                                          BevelWidth="20"
                                          Refraction="0.9"
                                          Dispersion="0.65"
                                          Specular="0.95"
                                          Cursor="SizeAll"
                                          PointerPressed="OnGlassDragStart"
                                          PointerMoved="OnGlassDragMove"
                                          PointerReleased="OnGlassDragEnd">
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="Drag Me Around"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="SkSL SDF Lens · GPU"
                                   FontSize="12"
                                   Opacity="0.75"
                                   HorizontalAlignment="Center" />
                      </StackPanel>
                    </vela:VelaLiquidGlass>

                    <!-- Floating Glass Pill Dock -->
                    <vela:VelaLiquidGlass x:Name="GlassDockSample"
                                          Canvas.Left="24"
                                          Canvas.Top="264"
                                          CornerRadius="999"
                                          Padding="12,6"
                                          BlurRadius="8"
                                          BevelWidth="14"
                                          Refraction="0.75"
                                          Dispersion="0.45"
                                          Specular="0.9">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <vela:VelaBadge Tone="Success" ShowDot="True" IsPill="True" Content="Metal / Skia GPU" />
                        <TextBlock Text="Floating Glass Bar" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                      </StackPanel>
                    </vela:VelaLiquidGlass>
                  </Canvas>
                </Grid>
              </Border>

              <!-- Live Optical Parameter Tuning -->
              <Border Classes="card" ClipToBounds="False">
                <StackPanel Spacing="22" ClipToBounds="False">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="cardTitle" Text="Live Optical Parameters" VerticalAlignment="Center" />
                    <vela:VelaSwitch x:Name="GlassRefractionSwitch"
                                     Grid.Column="1"
                                     Content="Enable SDF Refraction"
                                     IsChecked="True"
                                     IsCheckedChanged="OnGlassRefractionToggle" />
                  </Grid>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="28" RowDefinitions="Auto,Auto" RowSpacing="24" ClipToBounds="False">
                    <vela:VelaElasticSlider x:Name="GlassBlurSlider"
                                            Label="Backdrop Blur Radius"
                                            Minimum="0"
                                            Maximum="20"
                                            Value="4"
                                            Step="1"
                                            ValueSuffix=" px"
                                            ValueChanged="OnGlassParamChanged" />

                    <vela:VelaElasticSlider x:Name="GlassBevelSlider"
                                            Grid.Column="1"
                                            Label="Optical Bevel Width"
                                            Minimum="4"
                                            Maximum="36"
                                            Value="20"
                                            Step="1"
                                            ValueSuffix=" px"
                                            ValueChanged="OnGlassParamChanged" />

                    <vela:VelaElasticSlider x:Name="GlassRefractionSlider"
                                            Grid.Row="1"
                                            Label="Refraction Index Strength"
                                            Minimum="0"
                                            Maximum="140"
                                            Value="90"
                                            Step="5"
                                            ValueSuffix="%"
                                            ValueChanged="OnGlassParamChanged" />

                    <vela:VelaElasticSlider x:Name="GlassDispersionSlider"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Label="Chromatic Dispersion"
                                            Minimum="0"
                                            Maximum="140"
                                            Value="65"
                                            Step="5"
                                            ValueSuffix="%"
                                            ValueChanged="OnGlassParamChanged" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 4: Pickers, Cards & Metrics (Phase 6!) -->
      <vela:VelaNavItem Header="Pickers &amp; Cards"
                        Category="RadioCards TagInput Calendar DatePicker MetricCard Material"
                        Icon="{DynamicResource VelaIconCalendar}">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="22" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Pickers, RadioCards, Tags &amp; Metric Cards" />
                <TextBlock Classes="pageSubtitle"
                           Text="Everyday business building blocks: rolling KPI counters, gliding-ring radio cards, pill tag inputs, gliding-disc calendars, inverted tooltips, and unified Solid/Frosted/LiquidGlass overlays." />
              </StackPanel>

              <!-- Metric Cards Row -->
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Text="VelaMetricCard &amp; VelaAnimatedCounter" VerticalAlignment="Center" />
                  <vela:VelaButton Grid.Column="1" Variant="Secondary" Size="Small" Content="Simulate Quarter Jump" Click="OnSimulateMetricsClick" />
                </Grid>
                <UniformGrid Columns="3" ColumnSpacing="14">
                  <vela:VelaMetricCard x:Name="MetricRevenue"
                                       Label="Monthly Revenue"
                                       Value="48250"
                                       Prefix="$"
                                       Delta="+18.4%"
                                       DeltaTone="Success"
                                       Caption="vs. last 30 days"
                                       Icon="{DynamicResource VelaIconTrendingUp}" />
                  <vela:VelaMetricCard x:Name="MetricUsers"
                                       Label="Active Desktops"
                                       Value="12940"
                                       Delta="+6.2%"
                                       DeltaTone="Info"
                                       Caption="macOS · Windows · Linux"
                                       Icon="{DynamicResource VelaIconCompass}" />
                  <vela:VelaMetricCard x:Name="MetricLatency"
                                       Label="Avg Switch Latency"
                                       Value="0.12"
                                       Suffix=" ms"
                                       Decimals="2"
                                       Delta="-94%"
                                       DeltaTone="Accent"
                                       Caption="VelaPageDeck KeepAlive"
                                       Icon="{DynamicResource VelaIconSparkles}" />
                </UniformGrid>
              </StackPanel>

              <!-- RadioCards -->
              <Border Classes="card">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="cardTitle" Text="VelaRadioCards" />
                      <TextBlock Classes="cardDesc" Text="Click between cards to watch the 1.75px accent selection ring glide smoothly across." />
                    </StackPanel>
                    <vela:VelaSegmentedControl x:Name="RadioLayoutSegmented"
                                               Grid.Column="1"
                                               SelectedIndex="0"
                                               SelectionChanged="OnRadioLayoutChanged">
                      <x:String>Grid</x:String>
                      <x:String>List</x:String>
                    </vela:VelaSegmentedControl>
                  </Grid>

                  <vela:VelaRadioCards x:Name="PlanRadioCards" Layout="Grid" SelectedIndex="1">
                    <vela:VelaRadioCardItem Header="Starter"
                                            Description="For solo builders and open-source tools."
                                            Meta="$0 / mo"
                                            Icon="{DynamicResource VelaIconHome}" />
                    <vela:VelaRadioCardItem Header="Studio Pro"
                                            Description="Unlimited desktop apps, GPU shaders &amp; charts."
                                            Meta="$24 / mo"
                                            Icon="{DynamicResource VelaIconSparkles}" />
                    <vela:VelaRadioCardItem Header="Enterprise"
                                            Description="Dedicated support, custom tokens &amp; SLA."
                                            Meta="$89 / mo"
                                            Icon="{DynamicResource VelaIconLayers}" />
                  </vela:VelaRadioCards>
                </StackPanel>
              </Border>

              <!-- TagInput + DatePicker + Overlay Material Tester -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="18">
                    <vela:VelaTagInput x:Name="DemoTagInput"
                                       Label="VelaTagInput"
                                       Description="Type a tag and press Enter or Comma. Backspace deletes the last pill." />

                    <vela:VelaDatePicker x:Name="DemoDatePicker"
                                         Label="VelaDatePicker"
                                         PlaceholderText="Pick release date..." />

                    <!-- Unified Overlay Material Switcher -->
                    <StackPanel Spacing="10">
                      <TextBlock Text="Unified Overlay Material (Dialog &amp; Drawer)"
                                 FontSize="13"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource VelaForegroundBrush}" />
                      <vela:VelaSegmentedControl x:Name="OverlayMaterialSegmented" SelectedIndex="2">
                        <x:String>Solid</x:String>
                        <x:String>Frosted</x:String>
                        <x:String>LiquidGlass</x:String>
                      </vela:VelaSegmentedControl>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <vela:VelaButton Variant="Primary" Size="Small" Content="Test Material Dialog" Click="OnTestMaterialDialogClick" />
                        <vela:VelaButton Variant="Secondary" Size="Small" Content="Test Material Drawer" Click="OnTestMaterialDrawerClick" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Standalone VelaCalendar -->
                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Classes="cardTitle" Text="VelaCalendar (Gliding Disc)" />
                    <vela:VelaCalendar x:Name="InlineCalendar" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 5: Forms & Overlays (Batch 2 Controls!) -->
      <vela:VelaNavItem Header="Forms &amp; Overlays"
                        Category="Input CheckBox Badge Dialog Toast"
                        Icon="{DynamicResource VelaIconLayers}">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="20" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Forms, Badges &amp; Overlays" />
                <TextBlock Classes="pageSubtitle"
                           Text="Core foundational primitives: border-only focus inputs, 3-point morphing checkboxes, OKLab-tinted badges, AnimatePresence modal dialogs, and hover-pausing toast stacks." />
              </StackPanel>

              <!-- VelaInput Card -->
              <Border Classes="card">
                <StackPanel Spacing="16">
                  <TextBlock Classes="cardTitle" Text="VelaInput" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="14">
                    <vela:VelaInput Label="Email address"
                                    PlaceholderText="you@company.com"
                                    LeadingIcon="{DynamicResource VelaIconMail}"
                                    Description="We never share your email with third parties."
                                    IsClearable="True" />

                    <vela:VelaInput Grid.Column="1"
                                    Label="Workspace slug"
                                    Text="vela-invalid!!"
                                    ErrorMessage="Only lowercase letters, numbers, and hyphens are allowed."
                                    IsClearable="True" />

                    <vela:VelaInput Grid.Row="1"
                                    Label="Password"
                                    PlaceholderText="Enter password..."
                                    PasswordChar="•"
                                    Size="Medium" />

                    <vela:VelaInput Grid.Row="1"
                                    Grid.Column="1"
                                    Label="Disabled field"
                                    Text="Read-only preset"
                                    IsEnabled="False" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- VelaCheckBox + VelaBadge Row -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaCheckBox" />
                    <TextBlock Classes="cardDesc"
                               Text="3-point path morphing between checkmark and indeterminate dash on physical springs." />

                    <StackPanel Spacing="10">
                      <vela:VelaCheckBox Content="Enable hardware composition"
                                         Description="Runs opacity fades on Avalonia's render thread."
                                         IsChecked="True" />
                      <vela:VelaCheckBox Content="Tri-state selection (click to morph)"
                                         IsThreeState="True"
                                         IsChecked="{x:Null}" />
                      <vela:VelaCheckBox Content="Send weekly release notes"
                                         IsChecked="False" />
                      <vela:VelaCheckBox Content="Disabled checked"
                                         IsChecked="True"
                                         IsEnabled="False" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaBadge" />
                    <TextBlock Classes="cardDesc"
                               Text="OKLab-tinted semantic surfaces, optional status dots, pill and outline variants." />

                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                      <vela:VelaBadge Tone="Neutral" Content="Neutral" />
                      <vela:VelaBadge Tone="Accent" Content="Accent" />
                      <vela:VelaBadge Tone="Success" ShowDot="True" IsPill="True" Content="Operational" />
                      <vela:VelaBadge Tone="Warning" ShowDot="True" IsPill="True" Content="Degraded" />
                      <vela:VelaBadge Tone="Danger" ShowDot="True" IsPill="True" Content="Outage" />
                      <vela:VelaBadge Tone="Info" IsOutline="True" Content="v0.1.0-alpha" />
                      <vela:VelaBadge Tone="Neutral" Size="Small" IsOutline="True" Content="Small" />
                      <vela:VelaBadge Tone="Accent" Size="Large" IsPill="True" Content="Large Pill" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- VelaDialogHost & VelaToastHost Triggers -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaDialogHost" />
                    <TextBlock Classes="cardDesc"
                               Text="Decoupled async modal host with spring AnimatePresence entrance/exit, Esc &amp; backdrop dismiss." />

                    <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                      <vela:VelaButton Variant="Primary"
                                       Size="Small"
                                       Content="Confirm Dialog"
                                       Click="OnShowConfirmDialogClick" />
                      <vela:VelaButton Variant="Danger"
                                       Size="Small"
                                       Content="Destructive Dialog"
                                       Click="OnShowDestructiveDialogClick" />
                      <vela:VelaButton Variant="Secondary"
                                       Size="Small"
                                       Content="Custom Form Dialog"
                                       Click="OnShowCustomDialogClick" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaToastHost" />
                    <TextBlock Classes="cardDesc"
                               Text="Stacking notifications with spring enter/exit, hover-to-pause timer, and inline actions." />

                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                      <vela:VelaButton Variant="Secondary" Size="Small" Content="Success" Click="OnToastSuccessClick" />
                      <vela:VelaButton Variant="Secondary" Size="Small" Content="Info + Undo" Click="OnToastUndoClick" />
                      <vela:VelaButton Variant="Secondary" Size="Small" Content="Warning" Click="OnToastWarningClick" />
                      <vela:VelaButton Variant="Danger" Size="Small" Content="Error" Click="OnToastDangerClick" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 3: Select & Menus (Batch 3 Controls!) -->
      <vela:VelaNavItem Header="Select &amp; Menus"
                        Category="Select ComboBox Dropdown Popover ContextMenu"
                        Icon="{DynamicResource VelaIconList}">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="20" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Select, ComboBox, Menus &amp; Popover" />
                <TextBlock Classes="pageSubtitle"
                           Text="Static anchor triggers, spring-rotating chevrons, shared VelaPopupSurface entrance physics, gliding menu highlights, and themed native ContextMenu." />
              </StackPanel>

              <!-- VelaSelect + VelaComboBox -->
              <Border Classes="card">
                <StackPanel Spacing="16">
                  <TextBlock Classes="cardTitle" Text="Selection Fields" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                    <vela:VelaSelect x:Name="RegionSelect"
                                     Label="Deployment Region"
                                     PlaceholderText="Choose a region..."
                                     Description="Controls closest edge POP for desktop sync."
                                     SelectedIndex="0">
                      <x:String>Asia Pacific · Tokyo (ap-northeast-1)</x:String>
                      <x:String>Asia Pacific · Singapore (ap-southeast-1)</x:String>
                      <x:String>US West · Oregon (us-west-2)</x:String>
                      <x:String>Europe · Frankfurt (eu-central-1)</x:String>
                    </vela:VelaSelect>

                    <vela:VelaComboBox x:Name="FrameworkComboBox"
                                       Grid.Column="1"
                                       Label="Searchable ComboBox"
                                       PlaceholderText="Type to filter frameworks..."
                                       Description="Supports Up/Down/Enter/Esc and live search filtering." />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- VelaDropdownButton + VelaPopover -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaDropdownButton" />
                    <TextBlock Classes="cardDesc"
                               Text="Hover across items to see the gliding highlight pill; hover Delete to see it softly tint to danger." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <vela:VelaDropdownButton Content="Document Actions"
                                               LeadingIcon="{DynamicResource VelaIconList}">
                        <vela:VelaMenuItem Header="Rename"
                                           Icon="{DynamicResource VelaIconEdit}"
                                           Shortcut="⌘R"
                                           Click="OnMenuRenameClick" />
                        <vela:VelaMenuItem Header="Duplicate"
                                           Icon="{DynamicResource VelaIconCopy}"
                                           Shortcut="⌘D"
                                           Click="OnMenuDuplicateClick" />
                        <vela:VelaMenuItem Header="Share link"
                                           Icon="{DynamicResource VelaIconShare}"
                                           Shortcut="⇧⌘C"
                                           Click="OnMenuShareClick" />
                        <vela:VelaMenuItem IsSeparator="True" />
                        <vela:VelaMenuItem Header="Delete document"
                                           Icon="{DynamicResource VelaIconTrash}"
                                           Shortcut="⌫"
                                           IsDestructive="True"
                                           Click="OnMenuDeleteClick" />
                      </vela:VelaDropdownButton>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaPopover" />
                    <TextBlock Classes="cardDesc"
                               Text="Anchored floating panel with directional spring entrance and light-dismiss." />

                    <vela:VelaPopover x:Name="QuickSettingsPopover"
                                      Placement="BottomEdgeAlignedLeft">
                      <vela:VelaButton Variant="Secondary" Size="Small" Content="Open Quick Popover" />
                      <vela:VelaPopover.PopoverContent>
                        <StackPanel Spacing="12" Width="250">
                          <TextBlock Text="Quick Display Preferences" FontSize="14" FontWeight="SemiBold" />
                          <vela:VelaCheckBox Content="Show performance bar" IsChecked="True" />
                          <vela:VelaCheckBox Content="Snap sliders to detents" IsChecked="True" />
                          <vela:VelaButton Variant="Primary"
                                           Size="Small"
                                           HorizontalAlignment="Right"
                                           Content="Done"
                                           Click="OnClosePopoverClick" />
                        </StackPanel>
                      </vela:VelaPopover.PopoverContent>
                    </vela:VelaPopover>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- Native Right-Click ContextMenu Zone -->
              <Border Classes="card"
                      Background="{DynamicResource VelaSurfaceMutedBrush}"
                      Cursor="Hand">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Edit item" InputGesture="Ctrl+E" Click="OnContextEditClick">
                      <MenuItem.Icon>
                        <PathIcon Width="14" Height="14" Data="{DynamicResource VelaIconEdit}" Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy path" InputGesture="Ctrl+C" Click="OnContextCopyClick">
                      <MenuItem.Icon>
                        <PathIcon Width="14" Height="14" Data="{DynamicResource VelaIconCopy}" Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Classes="danger" Header="Delete permanently" InputGesture="Delete" Click="OnContextDeleteClick">
                      <MenuItem.Icon>
                        <PathIcon Width="14" Height="14" Data="{DynamicResource VelaIconTrash}" Foreground="{DynamicResource VelaDangerBrush}" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Border.ContextMenu>

                <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,12">
                  <TextBlock Text="Right-click anywhere in this box"
                             FontSize="14"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="Tests Vela's native Avalonia ContextMenu &amp; MenuItem ControlTheme with spring surface entrance."
                             FontSize="12.5"
                             Foreground="{DynamicResource VelaTextSecondaryBrush}"
                             HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 4: Feedback & Panels (Batch 4 Controls!) -->
      <vela:VelaNavItem Header="Feedback &amp; Panels"
                        Category="Progress Skeleton Alert Accordion Drawer"
                        Icon="{DynamicResource VelaIconBell}">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="20" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Progress, Skeleton, Alert, Accordion &amp; Drawer" />
                <TextBlock Classes="pageSubtitle"
                           Text="Restrained status feedback and disclosure surfaces with spring progress, calm skeleton loading, hairline accordions, and slide-over drawers." />
              </StackPanel>

              <!-- VelaProgress -->
              <Border Classes="card">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="cardTitle" Text="VelaProgress" VerticalAlignment="Center" />
                    <vela:VelaSwitch x:Name="IndeterminateSwitch"
                                     Grid.Column="1"
                                     Content="Indeterminate"
                                     IsCheckedChanged="OnIndeterminateChanged" />
                  </Grid>

                  <vela:VelaProgress x:Name="DemoProgress"
                                     Label="Uploading build artifact"
                                     Value="42" />

                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                    <vela:VelaButton Variant="Secondary" Size="Small" Content="0%" Click="OnProgress0Click" />
                    <vela:VelaButton Variant="Secondary" Size="Small" Content="35%" Click="OnProgress35Click" />
                    <vela:VelaButton Variant="Secondary" Size="Small" Content="72%" Click="OnProgress72Click" />
                    <vela:VelaButton Variant="Primary" Size="Small" Content="100% Complete" Click="OnProgress100Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- VelaSkeleton + VelaDrawerHost Row -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="cardTitle" Text="VelaSkeleton" VerticalAlignment="Center" />
                      <vela:VelaSwitch x:Name="SkeletonLoadingSwitch"
                                       Grid.Column="1"
                                       Content="Loading"
                                       IsChecked="True"
                                       IsCheckedChanged="OnSkeletonToggleChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                      <vela:VelaSkeleton x:Name="SkelAvatar" Width="44" Height="44" IsCircle="True" IsLoading="True">
                        <Border Width="44" Height="44" CornerRadius="999" Background="{DynamicResource VelaAccentSubtleBrush}">
                          <TextBlock Text="VU" FontWeight="SemiBold" Foreground="{DynamicResource VelaAccentStrongBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </vela:VelaSkeleton>

                      <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <vela:VelaSkeleton x:Name="SkelLine1" Height="16" Width="150" HorizontalAlignment="Left" IsLoading="True">
                          <TextBlock Text="Vela.Avalonia Team" FontSize="14" FontWeight="SemiBold" />
                        </vela:VelaSkeleton>
                        <vela:VelaSkeleton x:Name="SkelLine2" Height="13" IsLoading="True">
                          <TextBlock Text="Avalonia 12.2 · Motion-first desktop primitives" FontSize="12.5"
                                     Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                        </vela:VelaSkeleton>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaDrawerHost" />
                    <TextBlock Classes="cardDesc"
                               Text="Floating side sheets with smooth spring slide-in/slide-out, Esc &amp; backdrop dismiss." />

                    <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                      <vela:VelaButton Variant="Primary" Size="Small" Content="Open Right Drawer" Click="OnOpenRightDrawerClick" />
                      <vela:VelaButton Variant="Secondary" Size="Small" Content="Open Left Drawer" Click="OnOpenLeftDrawerClick" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- VelaAlert -->
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="cardTitle" Text="VelaAlert" VerticalAlignment="Center" />
                    <vela:VelaButton Grid.Column="1" Variant="Ghost" Size="Small" Content="Restore dismissed" Click="OnRestoreAlertsClick" />
                  </Grid>

                  <vela:VelaAlert x:Name="AlertInfo"
                                  Tone="Info"
                                  Title="Avalonia 12.2 Composition Ready"
                                  Description="VelaPageDeck uses O(1) KeepAlive caching and optional render-thread fades."
                                  IsDismissible="True" />
                  <vela:VelaAlert x:Name="AlertSuccess"
                                  Tone="Success"
                                  Title="Design tokens synced"
                                  Description="All OKLCH surfaces and 8 accent palettes compiled cleanly with 0 warnings."
                                  IsDismissible="True" />
                  <vela:VelaAlert x:Name="AlertWarning"
                                  Tone="Warning"
                                  Title="High DPI scaling detected"
                                  Description="Keep PageTransitionMode set to Instant for zero offscreen GPU texture allocations."
                                  IsDismissible="True" />
                </StackPanel>
              </Border>

              <!-- VelaAccordion -->
              <Border Classes="card">
                <StackPanel Spacing="14">
                  <TextBlock Classes="cardTitle" Text="VelaAccordion" />
                  <vela:VelaAccordion AllowMultiple="False">
                    <vela:VelaAccordionItem Header="How does Vela isolate itself from FluentTheme?" IsExpanded="True">
                      <TextBlock TextWrapping="Wrap"
                                 Text="Composite Vela controls use internal VelaBareTextBoxTheme and VelaIconButtonTheme primitives so FluentTheme focus rings and button styles never leak into Vela fields." />
                    </vela:VelaAccordionItem>
                    <vela:VelaAccordionItem Header="Why is VelaPageDeck faster than a standard TabControl?">
                      <TextBlock TextWrapping="Wrap"
                                 Text="VelaPageDeck lazily instantiates pages on first visit, keeps them alive via KeepAlive or bounded LRU caching, and skips inactive pages completely during Measure and Arrange." />
                    </vela:VelaAccordionItem>
                    <vela:VelaAccordionItem Header="Does Vela support Reduced Motion accessibility?">
                      <TextBlock TextWrapping="Wrap"
                                 Text="Yes. Toggling VelaMotionOptions.ReducedMotion immediately snaps all spring channels, pauses skeleton pulses, and disables compositor transitions across every control." />
                    </vela:VelaAccordionItem>
                  </vela:VelaAccordion>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 5: Heavy Stress Benchmark (Lazy constructed via PageFactory in code-behind!) -->
      <vela:VelaNavItem x:Name="StressNavItem"
                        Header="Heavy Stress"
                        Category="Benchmark Performance 500 Nodes"
                        Icon="{DynamicResource VelaIconSparkles}"
                        Badge="500" />

      <!-- Page 3: Actions & Toggles -->
      <vela:VelaNavItem Header="Actions &amp; Toggles"
                        Category="Buttons Switch Segmented"
                        Icon="{DynamicResource VelaIconComponents}">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="20" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Actions &amp; Toggles" />
                <TextBlock Classes="pageSubtitle"
                           Text="Restrained surfaces paired with physical press responses, width morphing, and gliding shared highlights." />
              </StackPanel>

              <Border Classes="card">
                <StackPanel Spacing="16">
                  <TextBlock Classes="cardTitle" Text="VelaButton" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                    <vela:VelaButton Variant="Primary" Content="Primary" />
                    <vela:VelaButton Variant="Secondary" Content="Secondary" />
                    <vela:VelaButton Variant="Ghost" Content="Ghost" />
                    <vela:VelaButton Variant="Danger" Content="Danger" />
                    <vela:VelaButton Variant="Secondary" Content="Disabled" IsEnabled="False" />
                  </WrapPanel>

                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <vela:VelaButton x:Name="MorphActionButton"
                                     Variant="Primary"
                                     Content="Save changes"
                                     Click="OnMorphButtonClick" />
                    <vela:VelaButton Variant="Secondary" Size="Small" Content="Small" />
                    <vela:VelaButton Variant="Secondary" Size="Large" Content="Large" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaSegmentedControl" />
                    <vela:VelaSegmentedControl x:Name="PlanSegmented"
                                               SelectedIndex="0"
                                               SelectionChanged="OnPlanSelectionChanged">
                      <x:String>Monthly</x:String>
                      <x:String>Quarterly</x:String>
                      <x:String>Yearly · Save 20%</x:String>
                    </vela:VelaSegmentedControl>
                    <TextBlock x:Name="PlanStatusText"
                               Text="Active plan: Monthly — flexible billing, cancel anytime."
                               FontSize="13"
                               Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="cardTitle" Text="VelaSwitch" />
                    <vela:VelaSwitch Content="Spring physics enabled" IsChecked="True" />
                    <vela:VelaSwitch Content="Hardware composition" IsChecked="True" />
                    <vela:VelaSwitch Content="Auto-sync OKLCH tokens" IsChecked="False" />
                    <vela:VelaSwitch Content="Disabled state" IsChecked="True" IsEnabled="False" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 4: Elastic Sliders -->
      <vela:VelaNavItem Header="Elastic Sliders"
                        Category="Inputs Physics Gestures"
                        Icon="{DynamicResource VelaIconSliders}">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="20" MaxWidth="860">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="VelaElasticSlider" />
                <TextBlock Classes="pageSubtitle"
                           Text="Rubber-band over-stretch past limits, magnetic detents, and velocity-driven swaying readout bubble." />
              </StackPanel>

              <Border Classes="card" ClipToBounds="False">
                <StackPanel Spacing="32" ClipToBounds="False">
                  <vela:VelaElasticSlider x:Name="VolumeSlider"
                                          Label="Master Volume"
                                          Minimum="0"
                                          Maximum="100"
                                          Value="64"
                                          Step="1"
                                          ValueSuffix="%" />

                  <vela:VelaElasticSlider x:Name="DetentSlider"
                                          Label="Canvas Zoom (Magnetic Detents)"
                                          Minimum="0"
                                          Maximum="200"
                                          Value="100"
                                          Step="5"
                                          ValueSuffix="%" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>

      <!-- Page 11: Data & Charts (Independent Vela.Avalonia.Charts Sub-Package!) -->
      <vela:VelaNavItem Header="Data &amp; Charts"
                        Category="Donut Line Bar Sparkline Gauge Heatmap Visualization"
                        Icon="{DynamicResource VelaIconChart}"
                        Badge="6">
        <vela:VelaNavItem.PageContent>
          <ScrollViewer Padding="32,28">
            <StackPanel Spacing="22" MaxWidth="900">
              <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Vela.Avalonia.Charts" />
                <TextBlock Classes="pageSubtitle"
                           Text="Zero-dependency vector chart sub-package sharing Vela's OKLCH series palette and physical spring engine: Line, Bar, Donut, Gauge, Sparkline, and Activity Heatmap." />
              </StackPanel>

              <!-- 1. VelaLineChart -->
              <Border Classes="card">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="cardTitle" Text="VelaLineChart" />
                      <TextBlock Classes="cardDesc" Text="Scrub horizontally for gliding crosshair &amp; readout; click legend dots to toggle series; switch ranges to morph curves." />
                    </StackPanel>
                    <vela:VelaSegmentedControl x:Name="LineRangeSegmented"
                                               Grid.Column="1"
                                               SelectedIndex="0"
                                               SelectionChanged="OnLineRangeChanged">
                      <x:String>7D</x:String>
                      <x:String>30D</x:String>
                      <x:String>90D</x:String>
                    </vela:VelaSegmentedControl>
                  </Grid>

                  <charts:VelaLineChart x:Name="ShowcaseLineChart"
                                        Height="248"
                                        ValuePrefix="$" />
                </StackPanel>
              </Border>

              <!-- 2. VelaBarChart + 3. VelaDonutChart -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="cardTitle" Text="VelaBarChart" VerticalAlignment="Center" />
                      <vela:VelaSegmentedControl x:Name="BarRangeSegmented"
                                                 Grid.Column="1"
                                                 SelectedIndex="0"
                                                 SelectionChanged="OnBarRangeChanged">
                        <x:String>Week A</x:String>
                        <x:String>Week B</x:String>
                      </vela:VelaSegmentedControl>
                    </Grid>
                    <charts:VelaBarChart x:Name="ShowcaseBarChart" Height="220" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="cardTitle" Text="VelaDonutChart" VerticalAlignment="Center" />
                      <vela:VelaSegmentedControl x:Name="ChartDatasetSegmented"
                                                 Grid.Column="1"
                                                 SelectedIndex="0"
                                                 SelectionChanged="OnChartDatasetChanged">
                        <x:String>Q1</x:String>
                        <x:String>Q2</x:String>
                        <x:String>MRR</x:String>
                      </vela:VelaSegmentedControl>
                    </Grid>
                    <charts:VelaDonutChart x:Name="ShowcaseDonut"
                                           HorizontalAlignment="Center"
                                           RingSize="196"
                                           Thickness="24"
                                           TotalLabel="Q1 visits" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 4. VelaGauge + 5. VelaSparkline -->
              <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="20">
                <Border Classes="card">
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="cardTitle" Text="VelaGauge (Spring Arcs &amp; Thresholds)" VerticalAlignment="Center" />
                      <vela:VelaButton Grid.Column="1" Variant="Secondary" Size="Small" Content="Randomize" Click="OnRandomizeGaugesClick" />
                    </Grid>
                    <UniformGrid Columns="3">
                      <charts:VelaGauge x:Name="GaugeCpu" Label="CPU Load" Value="42" UseSemanticThresholds="True" Width="138" Height="124" StrokeThickness="12" />
                      <charts:VelaGauge x:Name="GaugeMem" Label="Memory" Value="74" UseSemanticThresholds="True" Width="138" Height="124" StrokeThickness="12" />
                      <charts:VelaGauge x:Name="GaugeGpu" Label="GPU Sync" Value="89" UseSemanticThresholds="False" Width="138" Height="124" StrokeThickness="12" />
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="cardTitle" Text="VelaSparkline" />
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="Active Sessions" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="4,218" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <charts:VelaSparkline x:Name="Spark1" Grid.Column="2" Width="96" Height="28" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="Frame Budget" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="1.8 ms" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <charts:VelaSparkline x:Name="Spark2" Grid.Column="2" Width="96" Height="28" StrokeColor="#10A870" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="Error Rate" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="0.04%" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <charts:VelaSparkline x:Name="Spark3" Grid.Column="2" Width="96" Height="28" StrokeColor="#EC564B" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 6. VelaActivityHeatmap -->
              <Border Classes="card">
                <StackPanel Spacing="14">
                  <TextBlock Classes="cardTitle" Text="VelaActivityHeatmap (36 Weeks)" />
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <charts:VelaActivityHeatmap x:Name="ShowcaseHeatmap" Weeks="36" CellSize="13" CellGap="3.5" />
                  </ScrollViewer>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </vela:VelaNavItem.PageContent>
      </vela:VelaNavItem>
        </vela:VelaNavigationView>
          </DockPanel>
        </vela:VelaDialogHost>
      </vela:VelaDrawerHost>
    </vela:VelaCommandPalette>

    <!-- Non-intrusive stacking toast overlay -->
    <vela:VelaToastHost x:Name="ToastHost" />
  </Grid>
</UserControl>
