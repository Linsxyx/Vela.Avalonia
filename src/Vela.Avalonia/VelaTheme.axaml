        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vela.Avalonia.VelaTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Vela.Avalonia/Icons/VelaIcons.axaml" />
