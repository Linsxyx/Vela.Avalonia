<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Vela.Avalonia.VelaTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Foundation: always loaded (icons, design/color tokens, bare primitives, scrollbar, tooltip) -->
        <ResourceInclude Source="avares://Vela.Avalonia/Icons/VelaIcons.axaml" />
        <ResourceInclude Source="avares://Vela.Avalonia/Tokens/VelaDesignTokens.axaml" />
        <ResourceInclude Source="avares://Vela.Avalonia/Tokens/VelaColorTokens.axaml" />
        <ResourceInclude Source="avares://Vela.Avalonia/Themes/VelaPrimitives.axaml" />
        <ResourceInclude Source="avares://Vela.Avalonia/Themes/VelaScrollBar.axaml" />
        <ResourceInclude Source="avares://Vela.Avalonia/Themes/VelaToolTip.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Wrap long string ToolTip content cleanly within MaxWidth -->
  <Style Selector="ToolTip TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
