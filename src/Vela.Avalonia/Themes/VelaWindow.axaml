<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
                    xmlns:controls="using:Vela.Avalonia.Controls">

  <ControlTheme x:Key="VelaCaptionButtonTheme" TargetType="Button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Bg"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>
    <Style Selector="^.close:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource VelaDangerBrush}" />
    </Style>
    <Style Selector="^.close:pointerover">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:VelaWindow}" TargetType="controls:VelaWindow">
    <Setter Property="Background" Value="{DynamicResource VelaBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource VelaBackgroundBrush}" />
    <Setter Property="TitleBarBackground" Value="{DynamicResource VelaSidebarBackgroundBrush}" />
    <Setter Property="TitleBarBorderBrush" Value="{DynamicResource VelaBorderSubtleBrush}" />
    <Setter Property="BottomBarBackground" Value="{DynamicResource VelaSidebarBackgroundBrush}" />
    <Setter Property="BottomBarBorderBrush" Value="{DynamicResource VelaBorderSubtleBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="PART_Root">
          <Border Name="PART_TransparencyFallback"
                  CornerRadius="{TemplateBinding EffectiveRootCornerRadius}"
                  IsHitTestVisible="False"
                  Background="{TemplateBinding TransparencyBackgroundFallback}" />
          <Border x:Name="PART_WindowSurface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding EffectiveRootCornerRadius}"
                  ClipToBounds="True">
            <VisualLayerManager>
              <Panel>
                <!-- Built-in Material Shader Background (activated via BackgroundMaterial="Shader") -->
                <controls:VelaShaderBackground x:Name="PART_MaterialShader"
                                               Preset="{TemplateBinding BackgroundPreset}"
                                               ShaderCode="{TemplateBinding BackgroundShaderCode}"
                                               ShaderFile="{TemplateBinding BackgroundShaderFile}"
                                               IsAnimated="{TemplateBinding BackgroundAnimated}"
                                               Intensity="{TemplateBinding BackgroundIntensity}"
                                               Speed="{TemplateBinding BackgroundSpeed}"
                                               TransitionDuration="{TemplateBinding BackgroundTransitionDuration}"
                                               ForceSoftwareRendering="{TemplateBinding BackgroundForceSoftwareRendering}"
                                               Opacity="{TemplateBinding BackgroundContentOpacity}"
                                               IsHitTestVisible="False"
                                               IsVisible="{TemplateBinding IsShaderBackgroundActive}" />

                <!-- Replaceable Full-Window Background Layer (Shader, Wallpaper, Gradient, Custom) -->
                <ContentPresenter x:Name="PART_BackgroundHost"
                                  Content="{TemplateBinding BackgroundContent}"
                                  Opacity="{TemplateBinding BackgroundContentOpacity}"
                                  IsHitTestVisible="False"
                                  IsVisible="{TemplateBinding BackgroundContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <Grid RowDefinitions="Auto,*,Auto">
                  <!-- Window Content (spans row 0+1 when ExtendContentIntoTitleBar is true) -->
                  <ContentPresenter x:Name="PART_ContentPresenter"
                                    Grid.Row="1"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

                  <!-- Optional Sleek Cross-Platform TitleBar -->
                  <Border x:Name="PART_TitleBar"
                          Grid.Row="0"
                          ZIndex="10"
                          Height="{TemplateBinding TitleBarHeight}"
                          Background="{TemplateBinding TitleBarBackground}"
                          BorderBrush="{TemplateBinding TitleBarBorderBrush}"
                          BorderThickness="0,0,0,1"
                          Padding="{TemplateBinding TitleBarPadding}"
                          chrome:WindowDecorationProperties.ElementRole="TitleBar"
                          IsVisible="{TemplateBinding EffectiveTitleBarVisible}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                      <!-- Mode A: Full Custom TitleBarContent -->
                      <ContentPresenter Grid.Column="0"
                                        Content="{TemplateBinding TitleBarContent}"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        chrome:WindowDecorationProperties.ElementRole="User"
                                        IsVisible="{TemplateBinding TitleBarContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

                      <!-- Mode B: Built-in 3-Column TitleBar Slots -->
                      <Grid Grid.Column="0"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10"
                            IsVisible="{TemplateBinding TitleBarContent, Converter={x:Static ObjectConverters.IsNull}}">
                        <!-- Left Slot (automatically inset 78px on macOS for traffic lights) -->
                        <ContentPresenter Grid.Column="0"
                                          Content="{TemplateBinding TitleBarLeftContent}"
                                          chrome:WindowDecorationProperties.ElementRole="User"
                                          VerticalAlignment="Center" />

                        <!-- Center Slot / Default Quiet Window Title -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                          <ContentPresenter Content="{TemplateBinding TitleBarCenterContent}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            chrome:WindowDecorationProperties.ElementRole="User"
                                            IsVisible="{TemplateBinding TitleBarCenterContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <TextBlock Text="{TemplateBinding Title}"
                                     FontSize="12.5"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource VelaTextSecondaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     IsHitTestVisible="False"
                                     IsVisible="{TemplateBinding ShowDefaultTitle}" />
                        </Grid>

                        <!-- Right Slot -->
                        <ContentPresenter Grid.Column="2"
                                          Content="{TemplateBinding TitleBarRightContent}"
                                          chrome:WindowDecorationProperties.ElementRole="User"
                                          VerticalAlignment="Center" />
                      </Grid>

                      <!-- Optional Window Action & Caption Buttons (always preserved even with custom TitleBarContent) -->
                      <StackPanel x:Name="PART_WindowActions"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                  Spacing="2"
                                  Margin="4,0,0,0"
                                  VerticalAlignment="Center"
                                  chrome:WindowDecorationProperties.ElementRole="User">
                        <Button x:Name="PART_PinButton"
                                Theme="{DynamicResource VelaCaptionButtonTheme}"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                IsVisible="{TemplateBinding CanPin}"
                                ToolTip.Tip="Keep on Top">
                          <PathIcon x:Name="PART_PinIcon"
                                    Width="11" Height="11"
                                    Data="M16 12V4H17V2H7V4H8V12L6 14V16H11.2V22H12.8V16H18V14L16 12Z" />
                        </Button>
                        <Button x:Name="PART_FullScreenButton"
                                Theme="{DynamicResource VelaCaptionButtonTheme}"
                                chrome:WindowDecorationProperties.ElementRole="User"
                                IsVisible="{TemplateBinding CanFullScreen}"
                                ToolTip.Tip="Full Screen">
                          <PathIcon x:Name="PART_FullScreenIcon"
                                    Width="11" Height="11"
                                    Data="M7 14H5V19H10V17H7V14ZM5 10H7V7H10V5H5V10ZM17 17H14V19H19V14H17V17ZM14 5V7H17V10H19V5H14Z" />
                        </Button>
                        <StackPanel x:Name="PART_CaptionButtons"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center"
                                    IsVisible="{TemplateBinding ShowCustomCaptionButtons}">
                          <Button x:Name="PART_MinimizeButton"
                                  Theme="{DynamicResource VelaCaptionButtonTheme}"
                                  chrome:WindowDecorationProperties.ElementRole="User"
                                  IsVisible="{TemplateBinding CanMinimize}"
                                  ToolTip.Tip="Minimize">
                            <PathIcon Width="10" Height="10"
                                      Data="M2 11H22V13H2Z" />
                          </Button>
                          <Button x:Name="PART_MaximizeButton"
                                  Theme="{DynamicResource VelaCaptionButtonTheme}"
                                  chrome:WindowDecorationProperties.ElementRole="User"
                                  IsVisible="{TemplateBinding CanMaximize}"
                                  ToolTip.Tip="Maximize">
                            <PathIcon x:Name="PART_MaximizeIcon"
                                      Width="10" Height="10"
                                      Data="M4 4H20V20H4V4ZM6 6V18H18V6H6Z" />
                          </Button>
                          <Button x:Name="PART_CloseButton"
                                  Classes="close"
                                  Theme="{DynamicResource VelaCaptionButtonTheme}"
                                  chrome:WindowDecorationProperties.ElementRole="User"
                                  ToolTip.Tip="Close">
                            <PathIcon Width="10" Height="10"
                                      Data="{DynamicResource VelaIconClose}" />
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Optional Custom BottomBar (Status bar, Dock, Media bar, or 3-column slots) -->
                  <Border x:Name="PART_BottomBar"
                          Grid.Row="2"
                          Height="{TemplateBinding BottomBarHeight}"
                          Background="{TemplateBinding BottomBarBackground}"
                          BorderBrush="{TemplateBinding BottomBarBorderBrush}"
                          BorderThickness="0,1,0,0"
                          Padding="{TemplateBinding BottomBarPadding}"
                          IsVisible="{TemplateBinding EffectiveBottomBarVisible}">
                    <Panel>
                      <!-- Mode A: Full Custom BottomBarContent -->
                      <ContentPresenter Content="{TemplateBinding BottomBarContent}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        IsVisible="{TemplateBinding BottomBarContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

                      <!-- Mode B: Built-in 3-Column BottomBar Slots -->
                      <Grid ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10"
                            IsVisible="{TemplateBinding BottomBarContent, Converter={x:Static ObjectConverters.IsNull}}">
                        <ContentPresenter Grid.Column="0"
                                          Content="{TemplateBinding BottomBarLeftContent}"
                                          VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding BottomBarCenterContent}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="2"
                                          Content="{TemplateBinding BottomBarRightContent}"
                                          VerticalAlignment="Center" />
                      </Grid>
                    </Panel>
                  </Border>
                </Grid>

                <!-- Top-Level Overlay Hosts (Dialogs, Drawers, Toasts above chrome & material background) -->
                <ItemsControl x:Name="PART_Hosts"
                              ZIndex="100"
                              ItemsSource="{TemplateBinding Hosts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Panel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Panel>
            </VisualLayerManager>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:native-material">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="^:maximized:not(:macos) /template/ Panel#PART_Root">
      <Setter Property="Margin" Value="{TemplateBinding OffScreenMargin}" />
    </Style>

    <Style Selector="^:maximized /template/ PathIcon#PART_MaximizeIcon">
      <Setter Property="Data" Value="M7 4H20V17H18V6H7V4ZM4 7H17V20H4V7ZM6 9V18H15V9H6Z" />
    </Style>
    <Style Selector="^:maximized /template/ Button#PART_MaximizeButton">
      <Setter Property="ToolTip.Tip" Value="Restore" />
    </Style>

    <Style Selector="^:fullscreen /template/ Button#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ PathIcon#PART_FullScreenIcon">
      <Setter Property="Data" Value="M5 16H8V19H10V14H5V16ZM8 8H5V10H10V5H8V8ZM14 19H16V16H19V14H14V19ZM16 8V5H14V10H19V8H16Z" />
    </Style>
    <Style Selector="^:fullscreen /template/ Button#PART_FullScreenButton">
      <Setter Property="ToolTip.Tip" Value="Exit Full Screen" />
    </Style>

    <Style Selector="^:topmost /template/ Button#PART_PinButton">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccentBrush}" />
      <Setter Property="ToolTip.Tip" Value="Unpin" />
    </Style>

    <Style Selector="^:not(:custom-chrome) /template/ Border#PART_TitleBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:no-titlebar-bg /template/ Border#PART_TitleBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="^:material-background /template/ Border#PART_BottomBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="^:no-titlebar-divider /template/ Border#PART_TitleBar">
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="^:no-bottombar-divider /template/ Border#PART_BottomBar">
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="^:extend-content /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.RowSpan" Value="2" />
    </Style>
    <Style Selector="^:extend-content /template/ Border#PART_TitleBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
