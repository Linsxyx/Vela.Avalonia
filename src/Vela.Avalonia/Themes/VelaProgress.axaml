<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Vela.Avalonia.Controls">

  <ControlTheme x:Key="{x:Type controls:VelaProgress}" TargetType="controls:VelaProgress">
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource VelaTextSm}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="8">
          <!-- Meta row: Label + percentage / completion check -->
          <Grid ColumnDefinitions="*,Auto"
                IsVisible="{TemplateBinding ShowValue}">
            <TextBlock Text="{TemplateBinding Label}"
                       Foreground="{DynamicResource VelaTextSecondaryBrush}"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="5"
                        VerticalAlignment="Center">
              <PathIcon x:Name="PART_DoneIcon"
                        Width="14"
                        Height="14"
                        Data="{DynamicResource VelaIconCheckCircle}"
                        Foreground="{DynamicResource VelaSuccessBrush}"
                        IsVisible="False" />
              <TextBlock x:Name="PART_Percent"
                         Text="{TemplateBinding DisplayPercent}"
                         Foreground="{DynamicResource VelaTextMutedBrush}"
                         FontSize="12.5"
                         FontWeight="Medium"
                         MinWidth="34"
                         TextAlignment="Right" />
            </StackPanel>
          </Grid>

          <!-- 7px pill track -->
          <Border x:Name="PART_Track"
                  Height="7"
                  CornerRadius="{DynamicResource VelaRadiusPill}"
                  Background="{DynamicResource VelaSurfaceMutedBrush}"
                  BorderBrush="{DynamicResource VelaBorderBrush}"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Grid>
              <Border x:Name="PART_Fill"
                      CornerRadius="{DynamicResource VelaRadiusPill}"
                      Background="{DynamicResource VelaAccentBrush}">
                <Border.Transitions>
                  <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.28" />
                  </Transitions>
                </Border.Transitions>
              </Border>

              <!-- Indeterminate bar -->
              <Border x:Name="PART_IndeterminateBar"
                      Width="110"
                      HorizontalAlignment="Left"
                      CornerRadius="{DynamicResource VelaRadiusPill}"
                      Background="{DynamicResource VelaAccentBrush}"
                      IsVisible="False">
                <Border.RenderTransform>
                  <TranslateTransform />
                </Border.RenderTransform>
              </Border>
            </Grid>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- Complete state (100% -> success green + check icon) -->
    <Style Selector="^:complete /template/ Border#PART_Fill">
      <Setter Property="Background" Value="{DynamicResource VelaSuccessBrush}" />
    </Style>
    <Style Selector="^:complete /template/ PathIcon#PART_DoneIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:complete /template/ TextBlock#PART_Percent">
      <Setter Property="Foreground" Value="{DynamicResource VelaSuccessBrush}" />
    </Style>

    <!-- Indeterminate sliding animation -->
    <Style Selector="^:indeterminate /template/ Border#PART_Fill">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ TextBlock#PART_Percent">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_IndeterminateBar">
      <Setter Property="IsVisible" Value="True" />
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="CubicEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-110" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="460" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

</ResourceDictionary>
