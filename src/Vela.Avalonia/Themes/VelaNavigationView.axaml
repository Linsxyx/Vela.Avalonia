<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Vela.Avalonia.Controls">

  <!-- Restrained, monochrome VelaNavItem: crisp typography, zero visual clutter, fixed 44px icon slot -->
  <ControlTheme x:Key="{x:Type controls:VelaNavItem}" TargetType="controls:VelaNavItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_HoverBorder"
                Background="Transparent"
                CornerRadius="10"
                ClipToBounds="True">
          <DockPanel LastChildFill="True">
            <!-- Fixed 44px leading slot (centered at x=22 -> 8 + 22 = 30 = 60/2 dead center of compact rail) -->
            <Panel x:Name="PART_IconSlot"
                   DockPanel.Dock="Left"
                   Width="44"
                   Height="36">
              <PathIcon x:Name="PART_Icon"
                        Width="16"
                        Height="16"
                        Data="{TemplateBinding Icon}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Panel>

            <!-- Quiet monochrome badge (only shown when explicitly set) -->
            <Border x:Name="PART_Badge"
                    DockPanel.Dock="Right"
                    Margin="4,0,10,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    CornerRadius="{DynamicResource VelaRadiusPill}"
                    Background="{DynamicResource VelaSurfaceMutedBrush}"
                    Opacity="{TemplateBinding LabelOpacity}"
                    IsVisible="{TemplateBinding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentPresenter Content="{TemplateBinding Badge}"
                                TextElement.FontSize="11"
                                TextElement.FontWeight="Medium"
                                TextElement.Foreground="{DynamicResource VelaTextMutedBrush}" />
            </Border>

            <TextBlock x:Name="PART_Header"
                       Text="{TemplateBinding Header}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0"
                       Opacity="{TemplateBinding LabelOpacity}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover:not(:selected) /template/ Border#PART_HoverBorder">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>

    <!-- Restrained active state: sharp primary foreground, no loud neon tint -->
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Badge ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>

    <!-- Top DisplayMode -->
    <Style Selector="^:top">
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="^:top /template/ Panel#PART_IconSlot">
      <Setter Property="Width" Value="28" />
      <Setter Property="Margin" Value="6,0,-2,0" />
    </Style>
    <Style Selector="^:top /template/ TextBlock#PART_Header">
      <Setter Property="Margin" Value="2,0,12,0" />
    </Style>
  </ControlTheme>

  <!-- Restrained, performance-first VelaNavigationView backed by VelaPageDeck -->
  <ControlTheme x:Key="{x:Type controls:VelaNavigationView}" TargetType="controls:VelaNavigationView">
    <Setter Property="Background" Value="{DynamicResource VelaBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel Background="{TemplateBinding Background}">
          <!-- Navigation Pane -->
          <Border x:Name="PART_Pane"
                  DockPanel.Dock="Left"
                  Background="{DynamicResource VelaSidebarBackgroundBrush}"
                  BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                  BorderThickness="0,0,1,0"
                  ClipToBounds="True">
            <DockPanel LastChildFill="True">
              <!-- Minimal Header + Toggle -->
              <Grid x:Name="PART_PaneHeaderRow"
                    DockPanel.Dock="Top"
                    Height="52"
                    Margin="8,4,8,2"
                    ColumnDefinitions="*,Auto">
                <Panel x:Name="PART_HeaderHost"
                       VerticalAlignment="Center"
                       Margin="8,0,4,0"
                       ClipToBounds="True">
                  <ContentPresenter Content="{TemplateBinding Header}" />
                </Panel>

                <Button x:Name="PART_PaneToggle"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Margin="6,0"
                        Padding="0"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{TemplateBinding IsPaneToggleVisible}"
                        ToolTip.Tip="Toggle sidebar">
                  <PathIcon x:Name="PART_ToggleIcon"
                            Width="15"
                            Height="15"
                            Data="{DynamicResource VelaIconChevronLeft}"
                            Foreground="{DynamicResource VelaTextMutedBrush}" />
                </Button>
              </Grid>

              <!-- Optional Search Box (hidden by default) -->
              <Panel x:Name="PART_SearchFold"
                     DockPanel.Dock="Top"
                     Margin="8,0,8,6"
                     ClipToBounds="True">
                <Border Height="32"
                        CornerRadius="9"
                        Background="{DynamicResource VelaSurfaceMutedBrush}"
                        BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="8,0">
                  <DockPanel>
                    <PathIcon DockPanel.Dock="Left"
                              Width="13"
                              Height="13"
                              Margin="0,0,7,0"
                              Data="{DynamicResource VelaIconSearch}"
                              Foreground="{DynamicResource VelaTextMutedBrush}"
                              VerticalAlignment="Center" />
                    <TextBox Text="{TemplateBinding SearchText, Mode=TwoWay}"
                             PlaceholderText="Filter..."
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             MinHeight="0"
                             FontSize="12.5"
                             VerticalContentAlignment="Center" />
                  </DockPanel>
                </Border>
              </Panel>

              <!-- Footer -->
              <Panel x:Name="PART_FooterHost"
                     DockPanel.Dock="Bottom"
                     Margin="8,6,8,10"
                     ClipToBounds="True">
                <ContentPresenter Content="{TemplateBinding Footer}" />
              </Panel>

              <!-- Nav Items + Quiet Neutral Gliding Selection Surface -->
              <ScrollViewer x:Name="PART_ItemsScroller"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PART_NavTrack" Margin="8,4">
                  <Canvas IsHitTestVisible="False">
                    <Border x:Name="PART_ActiveIndicator"
                            CornerRadius="10"
                            Background="{DynamicResource VelaSurfaceBrush}"
                            BorderBrush="{DynamicResource VelaBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="{DynamicResource VelaShadowResting}"
                            IsHitTestVisible="False" />
                  </Canvas>

                  <ItemsPresenter x:Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Grid>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <!-- High-Performance Cached Page Deck -->
          <Border Background="{TemplateBinding Background}" ClipToBounds="True">
            <controls:VelaPageDeck x:Name="PART_PageDeck"
                                   PageCacheMode="{TemplateBinding PageCacheMode}"
                                   MaxCachedPages="{TemplateBinding MaxCachedPages}"
                                   TransitionMode="{TemplateBinding PageTransitionMode}"
                                   PageTemplate="{TemplateBinding PageTemplate}" />
          </Border>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Button#PART_PaneToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
    </Style>

    <Style Selector="^:left /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Width" Value="212" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="^:compact /template/ Grid#PART_PaneHeaderRow">
      <Setter Property="Margin" Value="0,4,0,2" />
    </Style>
    <Style Selector="^:compact /template/ Button#PART_PaneToggle">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Top Mode -->
    <Style Selector="^:top">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="^:top /template/ Border#PART_Pane">
      <Setter Property="DockPanel.Dock" Value="Top" />
      <Setter Property="Height" Value="52" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="^:top /template/ Grid#PART_PaneHeaderRow">
      <Setter Property="DockPanel.Dock" Value="Left" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Margin" Value="14,0,12,0" />
    </Style>
    <Style Selector="^:top /template/ Button#PART_PaneToggle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:top /template/ Panel#PART_FooterHost">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Margin" Value="10,0,14,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:top /template/ ScrollViewer#PART_ItemsScroller">
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:top /template/ Grid#PART_NavTrack">
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
