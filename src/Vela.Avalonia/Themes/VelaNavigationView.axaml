<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Vela.Avalonia.Controls">

  <!-- Quiet section heading ("Workspace", "Pinned") -> folds into centered hairline in compact rail -->
  <ControlTheme x:Key="{x:Type controls:VelaNavSectionHeader}" TargetType="controls:VelaNavSectionHeader">
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="0,10,0,2" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <TextBlock Text="{TemplateBinding Header}"
                     FontSize="11.5"
                     FontWeight="Medium"
                     Foreground="{DynamicResource VelaTextMutedBrush}"
                     VerticalAlignment="Center"
                     Margin="12,0,8,0"
                     Opacity="{TemplateBinding LabelOpacity}" />
          <Border Width="22"
                  Height="1"
                  HorizontalAlignment="Left"
                  Margin="11,0,0,0"
                  VerticalAlignment="Center"
                  Background="{DynamicResource VelaBorderBrush}"
                  Opacity="{TemplateBinding DividerOpacity}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Arc App Rail VelaNavItem: crisp monochrome row + quiet counter + collapsible tree children with 1px guide line -->
  <ControlTheme x:Key="{x:Type controls:VelaNavItem}" TargetType="controls:VelaNavItem">
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="0">
          <Border x:Name="PART_RowBorder"
                  Height="34"
                  Background="Transparent"
                  CornerRadius="9"
                  Cursor="Hand"
                  ClipToBounds="True">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>

            <DockPanel LastChildFill="True">
              <!-- Fixed 44px leading icon slot (centered at x=22 -> 8 + 22 = 30 = 60/2 dead center of compact rail) -->
              <Panel x:Name="PART_IconSlot"
                     DockPanel.Dock="Left"
                     Width="44"
                     Height="34">
                <PathIcon x:Name="PART_Icon"
                          Width="15.5"
                          Height="15.5"
                          Data="{TemplateBinding Icon}"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Panel>

              <!-- Collapsible Tree Chevron -->
              <Panel x:Name="PART_ChevronSlot"
                     DockPanel.Dock="Right"
                     Width="28"
                     Height="34"
                     Opacity="{TemplateBinding LabelOpacity}"
                     IsVisible="{TemplateBinding HasChildren}">
                <PathIcon x:Name="PART_Chevron"
                          Width="12.5"
                          Height="12.5"
                          Data="{StaticResource VelaIconChevronDown}"
                          Foreground="{DynamicResource VelaTextMutedBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
              </Panel>

              <!-- Quiet Right-Aligned Counter / Badge (e.g. "4", "⌘K") -->
              <ContentPresenter x:Name="PART_Badge"
                                DockPanel.Dock="Right"
                                Margin="6,0,11,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Badge}"
                                TextElement.FontSize="12"
                                TextElement.FontWeight="Normal"
                                TextElement.Foreground="{DynamicResource VelaTextMutedBrush}"
                                Opacity="{TemplateBinding LabelOpacity}"
                                IsVisible="{TemplateBinding Badge, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <TextBlock x:Name="PART_Header"
                         Text="{TemplateBinding Header}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,0,8,0"
                         Opacity="{TemplateBinding LabelOpacity}" />
            </DockPanel>
          </Border>

          <!-- Collapsible Nested Children with 1px Vertical Tree Guide Line -->
          <controls:VelaCollapsePanel x:Name="PART_ChildrenCollapse"
                                      IsExpanded="{TemplateBinding EffectiveExpanded}"
                                      IsVisible="{TemplateBinding HasChildren}">
            <Grid Margin="0,2,0,4">
              <!-- Vertical hairline aligned directly under parent icon center (x=21.5) -->
              <Border Width="1"
                      HorizontalAlignment="Left"
                      Margin="21.5,2,0,4"
                      Background="{DynamicResource VelaBorderBrush}" />

              <StackPanel x:Name="PART_ChildrenHost"
                          Spacing="2"
                          Margin="30,0,0,0" />
            </Grid>
          </controls:VelaCollapsePanel>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- Nested Child Item Styling: clean 12px indent when text-only, balanced 34px icon slot when icon is present -->
    <Style Selector="^:child:not(:has-icon) /template/ Panel#PART_IconSlot">
      <Setter Property="Width" Value="12" />
    </Style>
    <Style Selector="^:child:has-icon /template/ Panel#PART_IconSlot">
      <Setter Property="Width" Value="34" />
    </Style>
    <Style Selector="^:child:has-icon /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="^:child /template/ Border#PART_RowBorder">
      <Setter Property="Height" Value="32" />
    </Style>

    <!-- Subtle hover on non-selected rows -->
    <Style Selector="^:not(:selected) /template/ Border#PART_RowBorder:pointerover">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
    </Style>
    <Style Selector="^ /template/ Border#PART_RowBorder:pointerover">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>

    <!-- Crisp Monochrome Selected State -->
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_Badge">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>

    <!-- Sticky Footer Item Selected Surface (outside scrollable indicator track) -->
    <Style Selector="^:footer-item:selected /template/ Border#PART_RowBorder">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
    </Style>

    <!-- Top DisplayMode -->
    <Style Selector="^:top /template/ Border#PART_RowBorder">
      <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="^:top /template/ Panel#PART_IconSlot">
      <Setter Property="Width" Value="28" />
      <Setter Property="Margin" Value="6,0,-2,0" />
    </Style>
    <Style Selector="^:top /template/ TextBlock#PART_Header">
      <Setter Property="Margin" Value="2,0,12,0" />
    </Style>
  </ControlTheme>

  <!-- Arc App Rail VelaNavigationView backed by VelaPageDeck -->
  <ControlTheme x:Key="{x:Type controls:VelaNavigationView}" TargetType="controls:VelaNavigationView">
    <Setter Property="Background" Value="{DynamicResource VelaBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    <Setter Property="TopBarBackground" Value="{DynamicResource VelaSurfaceBrush}" />
    <Setter Property="BottomBarBackground" Value="{DynamicResource VelaSidebarBackgroundBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <!-- Optional Replaceable Background Layer -->
          <ContentPresenter x:Name="PART_BackgroundHost"
                            Content="{TemplateBinding BackgroundContent}"
                            Opacity="{TemplateBinding BackgroundContentOpacity}"
                            IsHitTestVisible="False"
                            IsVisible="{TemplateBinding BackgroundContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

          <DockPanel LastChildFill="True">
            <!-- Optional Custom BottomBar (spans full navigation shell width) -->
            <Border x:Name="PART_BottomBar"
                    DockPanel.Dock="Bottom"
                    Height="{TemplateBinding BottomBarHeight}"
                    Background="{TemplateBinding BottomBarBackground}"
                    BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="{TemplateBinding BottomBarPadding}"
                    IsVisible="{TemplateBinding EffectiveBottomBarVisible}">
              <Panel>
                <ContentPresenter Content="{TemplateBinding BottomBarContent}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsVisible="{TemplateBinding BottomBarContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      IsVisible="{TemplateBinding BottomBarContent, Converter={x:Static ObjectConverters.IsNull}}">
                  <ContentPresenter Grid.Column="0"
                                    Content="{TemplateBinding BottomBarLeftContent}"
                                    VerticalAlignment="Center" />
                  <ContentPresenter Grid.Column="1"
                                    Content="{TemplateBinding BottomBarCenterContent}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                  <ContentPresenter Grid.Column="2"
                                    Content="{TemplateBinding BottomBarRightContent}"
                                    VerticalAlignment="Center" />
                </Grid>
              </Panel>
            </Border>

            <!-- Navigation Pane (Sidebar / Top Bar) -->
          <Border x:Name="PART_Pane"
                  DockPanel.Dock="Left"
                  Background="{DynamicResource VelaSidebarBackgroundBrush}"
                  BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                  BorderThickness="0,0,1,0"
                  ClipToBounds="True">
            <DockPanel LastChildFill="True">
              <!-- Brand Header Row (dual expanded + compact emblem layers for zero-jump rail collapse) -->
              <Grid x:Name="PART_PaneHeaderRow"
                    DockPanel.Dock="Top"
                    Height="56"
                    Margin="8,4,8,2"
                    ColumnDefinitions="*,Auto">
                <Panel x:Name="PART_HeaderHost"
                       VerticalAlignment="Center"
                       Margin="6,0,4,0"
                       ClipToBounds="True">
                  <ContentPresenter Content="{TemplateBinding Header}" />
                </Panel>

                <!-- Compact Icon Rail Brand Emblem (visible when collapsed) -->
                <Panel x:Name="PART_CompactHeaderHost"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0"
                       IsHitTestVisible="False">
                  <ContentPresenter Content="{TemplateBinding CompactHeader}" />
                </Panel>

                <!-- Pane Toggle Button (auto-hides when ShowTopBar is true so toggle lives cleanly in TopBar) -->
                <Button x:Name="PART_PaneToggle"
                        Grid.Column="1"
                        Theme="{StaticResource VelaIconButtonTheme}"
                        Width="30"
                        Height="30"
                        Margin="4,0"
                        CornerRadius="8"
                        IsVisible="{TemplateBinding IsPaneToggleVisible}"
                        ToolTip.Tip="Toggle sidebar">
                  <PathIcon x:Name="PART_ToggleIcon"
                            Width="14"
                            Height="14"
                            Data="{StaticResource VelaIconChevronLeft}"
                            Foreground="{DynamicResource VelaTextMutedBrush}" />
                </Button>
              </Grid>

              <!-- Optional Search Box -->
              <Panel x:Name="PART_SearchFold"
                     DockPanel.Dock="Top"
                     Margin="8,0,8,6"
                     ClipToBounds="True">
                <Border Height="32"
                        CornerRadius="9"
                        Background="{DynamicResource VelaSurfaceMutedBrush}"
                        BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                        BorderThickness="1"
                        Padding="8,0">
                  <DockPanel>
                    <PathIcon DockPanel.Dock="Left"
                              Width="13"
                              Height="13"
                              Margin="0,0,7,0"
                              Data="{StaticResource VelaIconSearch}"
                              Foreground="{DynamicResource VelaTextMutedBrush}"
                              VerticalAlignment="Center" />
                    <TextBox Theme="{DynamicResource VelaBareTextBoxTheme}"
                             Text="{TemplateBinding SearchText, Mode=TwoWay}"
                             PlaceholderText="Filter navigation..."
                             FontSize="12.5" />
                  </DockPanel>
                </Border>
              </Panel>

              <!-- Separated Profile / Account Footer (bottom-most) -->
              <Border x:Name="PART_FooterSection"
                      DockPanel.Dock="Bottom"
                      BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="8,10">
                <Grid>
                  <Panel x:Name="PART_FooterHost" ClipToBounds="True">
                    <ContentPresenter Content="{TemplateBinding Footer}" />
                  </Panel>
                  <Panel x:Name="PART_CompactFooterHost"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0"
                         IsHitTestVisible="False">
                    <ContentPresenter Content="{TemplateBinding CompactFooter}" />
                  </Panel>
                </Grid>
              </Border>

              <!-- Sticky Bottom Utility Items (e.g. Settings, Shortcuts — right above the footer hairline) -->
              <StackPanel x:Name="PART_FooterItemsHost"
                          DockPanel.Dock="Bottom"
                          Margin="8,4,8,8"
                          Spacing="2" />

              <!-- Main Scrollable Navigation Tree + Quiet Gliding Neutral Pill -->
              <ScrollViewer x:Name="PART_ItemsScroller"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <Grid x:Name="PART_NavTrack" Margin="8,4">
                  <Canvas IsHitTestVisible="False">
                    <Border x:Name="PART_ActiveIndicator"
                            CornerRadius="9"
                            Background="{DynamicResource VelaSurfaceMutedBrush}"
                            IsHitTestVisible="False" />
                  </Canvas>

                  <StackPanel x:Name="PART_ItemsHost"
                              Orientation="Vertical"
                              Spacing="2" />
                </Grid>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <!-- Content Area: Optional Arc TopBar + O(1) Cached VelaPageDeck -->
          <DockPanel x:Name="PART_ContentDock" Background="Transparent">
            <Border x:Name="PART_TopBar"
                    DockPanel.Dock="Top"
                    Height="{TemplateBinding TopBarHeight}"
                    Background="{TemplateBinding TopBarBackground}"
                    BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,18,0"
                    IsVisible="False">
              <Panel>
                <!-- Mode A: Full Custom TopBar -->
                <ContentPresenter Content="{TemplateBinding TopBarCustomContent}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsVisible="{TemplateBinding TopBarCustomContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Mode B: Built-in TopBar (Toggle + Left/Breadcrumb + Center + Right) -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                      ColumnSpacing="10"
                      IsVisible="{TemplateBinding TopBarCustomContent, Converter={x:Static ObjectConverters.IsNull}}">
                  <Button x:Name="PART_TopBarToggle"
                          Grid.Column="0"
                          Theme="{StaticResource VelaIconButtonTheme}"
                          Width="30"
                          Height="30"
                          CornerRadius="8"
                          IsVisible="{TemplateBinding IsPaneToggleVisible}"
                          ToolTip.Tip="Toggle sidebar">
                    <PathIcon Width="15"
                              Height="15"
                              Data="{StaticResource VelaIconSidebar}"
                              Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                  </Button>

                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="10"
                              VerticalAlignment="Center">
                    <ContentPresenter Content="{TemplateBinding TopBarLeftContent}"
                                      VerticalAlignment="Center"
                                      IsVisible="{TemplateBinding TopBarLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <controls:VelaBreadcrumb x:Name="PART_TopBreadcrumb"
                                             VerticalAlignment="Center"
                                             IsVisible="{TemplateBinding ShowTopBarBreadcrumb}" />
                  </StackPanel>

                  <ContentPresenter Grid.Column="2"
                                    Content="{TemplateBinding TopBarCenterContent}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{TemplateBinding TopBarCenterContent, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <ContentPresenter Grid.Column="3"
                                    Content="{TemplateBinding TopBarContent}"
                                    VerticalAlignment="Center" />
                </Grid>
              </Panel>
            </Border>

            <Border x:Name="PART_PageDeckHost" Background="Transparent" ClipToBounds="True">
              <controls:VelaPageDeck x:Name="PART_PageDeck"
                                     PageCacheMode="{TemplateBinding PageCacheMode}"
                                     MaxCachedPages="{TemplateBinding MaxCachedPages}"
                                     TransitionMode="{TemplateBinding PageTransitionMode}"
                                     PageTemplate="{TemplateBinding PageTemplate}" />
            </Border>
          </DockPanel>
        </DockPanel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Show TopBar & hide duplicate inline pane toggle when :topbar is active -->
    <Style Selector="^:topbar /template/ Border#PART_TopBar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:topbar /template/ Button#PART_PaneToggle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:no-topbar-divider /template/ Border#PART_TopBar">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:no-bottombar-divider /template/ Border#PART_BottomBar">
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Floating Sidebar Variant (inset rounded card) -->
    <Style Selector="^:floating /template/ Border#PART_Pane">
      <Setter Property="Margin" Value="10,10,0,10" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource VelaShadowResting}" />
    </Style>

    <!-- Frosted Sidebar Variant (translucent backdrop blur) -->
    <Style Selector="^:frosted /template/ Border#PART_Pane">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceBrush}" />
      <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="^:left /template/ StackPanel#PART_ItemsHost">
      <Setter Property="Width" Value="228" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:left /template/ StackPanel#PART_FooterItemsHost">
      <Setter Property="Width" Value="228" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="^:compact /template/ Grid#PART_PaneHeaderRow">
      <Setter Property="Margin" Value="0,4,0,2" />
    </Style>
    <Style Selector="^:compact:not(:topbar) /template/ Button#PART_PaneToggle">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Top Mode -->
    <Style Selector="^:top /template/ Border#PART_Pane">
      <Setter Property="DockPanel.Dock" Value="Top" />
      <Setter Property="Height" Value="52" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="^:top /template/ Grid#PART_PaneHeaderRow">
      <Setter Property="DockPanel.Dock" Value="Left" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Margin" Value="14,0,12,0" />
    </Style>
    <Style Selector="^:top /template/ Button#PART_PaneToggle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:top /template/ Border#PART_FooterSection">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0,14,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:top /template/ ScrollViewer#PART_ItemsScroller">
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:top /template/ Grid#PART_NavTrack">
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
