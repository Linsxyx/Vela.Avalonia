<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Vela.Avalonia.Controls">

  <ControlTheme x:Key="{x:Type controls:VelaPaymentFlow}" TargetType="controls:VelaPaymentFlow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource VelaBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="296" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <controls:VelaPaymentFlowCanvas x:Name="PART_Canvas" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:focus-visible /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccentBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
