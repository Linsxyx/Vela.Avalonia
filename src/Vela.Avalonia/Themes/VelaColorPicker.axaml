<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Vela.Avalonia.Controls">

  <ControlTheme x:Key="{x:Type controls:VelaColorPicker}" TargetType="controls:VelaColorPicker">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- Default Mode: Compact Swatch Trigger + Floating VelaPopupSurface -->
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Button x:Name="PART_Trigger"
                  Theme="{DynamicResource VelaIconButtonTheme}"
                  Background="{DynamicResource VelaSurfaceBrush}"
                  BorderBrush="{DynamicResource VelaBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="8,6,12,6"
                  MinHeight="40">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Width="24"
                      Height="24"
                      CornerRadius="7"
                      Background="{TemplateBinding PreviewBrush}"
                      BorderBrush="{DynamicResource VelaBorderStrongBrush}"
                      BorderThickness="1" />
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Label}"
                           FontSize="11.5"
                           FontWeight="Medium"
                           Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                <TextBlock Text="{TemplateBinding HexText}"
                           FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource VelaForegroundBrush}" />
              </StackPanel>
            </StackPanel>
          </Button>

          <Popup x:Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 IsOpen="{TemplateBinding IsOpen, Mode=TwoWay}"
                 PlacementTarget="PART_Trigger"
                 Placement="BottomEdgeAlignedLeft"
                 VerticalOffset="6"
                 IsLightDismissEnabled="True">
            <controls:VelaPopupSurface Margin="6,2,6,16"
                                       Width="288"
                                       Padding="14"
                                       CornerRadius="16"
                                       BorderThickness="1"
                                       Background="{DynamicResource VelaSurfaceRaisedBrush}"
                                       BorderBrush="{DynamicResource VelaBorderBrush}"
                                       BoxShadow="{DynamicResource VelaShadowFloating}">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Width="26"
                          Height="26"
                          CornerRadius="8"
                          Background="{TemplateBinding PreviewBrush}"
                          BorderBrush="{DynamicResource VelaBorderStrongBrush}"
                          BorderThickness="1" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{TemplateBinding Label}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VelaForegroundBrush}" />
                    <TextBlock Text="{TemplateBinding HexText}"
                               FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                               FontSize="11.5"
                               Foreground="{DynamicResource VelaTextMutedBrush}" />
                  </StackPanel>
                </Grid>

                <controls:VelaColorSpectrumCanvas x:Name="PART_Spectrum" Height="154" />

                <StackPanel Spacing="8">
                  <controls:VelaColorBarCanvas x:Name="PART_HueBar" Height="16" />
                  <controls:VelaColorBarCanvas x:Name="PART_AlphaBar"
                                               Height="16"
                                               IsVisible="{TemplateBinding ShowAlpha}" />
                </StackPanel>

                <Border Background="{DynamicResource VelaSurfaceMutedBrush}"
                        BorderBrush="{DynamicResource VelaBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="4"
                        Height="36">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Button x:Name="PART_FormatButton"
                            Theme="{DynamicResource VelaIconButtonTheme}"
                            Background="{DynamicResource VelaSurfaceBrush}"
                            BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="8,0"
                            MinWidth="54"
                            Height="26">
                      <TextBlock Text="{TemplateBinding FormatLabel}"
                                 FontSize="11.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                    </Button>
                    <TextBox x:Name="PART_ValueInput"
                             Grid.Column="1"
                             Theme="{DynamicResource VelaBareTextBoxTheme}"
                             FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Margin="4,0" />
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                      ColumnSpacing="8"
                      IsVisible="{TemplateBinding ShowContrast}">
                  <TextBlock Text="Aa"
                             FontSize="13.5"
                             FontWeight="Bold"
                             Foreground="{TemplateBinding PreviewBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{TemplateBinding ContrastRatioText}"
                             FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                             FontSize="12"
                             FontWeight="Medium"
                             Foreground="{DynamicResource VelaForegroundBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Text="contrast"
                             FontSize="11.5"
                             Foreground="{DynamicResource VelaTextMutedBrush}"
                             VerticalAlignment="Center" />
                  <Border x:Name="PART_GradePill"
                          Grid.Column="3"
                          CornerRadius="6"
                          Padding="7,2"
                          Background="{DynamicResource VelaSuccessSubtleBrush}">
                    <TextBlock Text="{TemplateBinding ContrastGrade}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VelaSuccessBrush}" />
                  </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button x:Name="PART_AddSwatch"
                          Theme="{DynamicResource VelaIconButtonTheme}"
                          Width="22"
                          Height="22"
                          CornerRadius="999"
                          Background="{DynamicResource VelaSurfaceMutedBrush}"
                          BorderBrush="{DynamicResource VelaBorderBrush}"
                          BorderThickness="1"
                          ToolTip.Tip="Save current color">
                    <PathIcon Width="11"
                              Height="11"
                              Data="{DynamicResource VelaIconPlus}"
                              Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                  </Button>
                  <StackPanel x:Name="PART_SwatchesHost"
                              Orientation="Horizontal"
                              Spacing="6"
                              VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </controls:VelaPopupSurface>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Inline Embedded Mode -->
    <Style Selector="^:inline">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Width="288"
                  Padding="14"
                  CornerRadius="16"
                  Background="{DynamicResource VelaSurfaceBrush}"
                  BorderBrush="{DynamicResource VelaBorderBrush}"
                  BorderThickness="1"
                  BoxShadow="{DynamicResource VelaShadowResting}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="26"
                        Height="26"
                        CornerRadius="8"
                        Background="{TemplateBinding PreviewBrush}"
                        BorderBrush="{DynamicResource VelaBorderStrongBrush}"
                        BorderThickness="1" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{TemplateBinding Label}"
                             FontSize="12.5"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource VelaForegroundBrush}" />
                  <TextBlock Text="{TemplateBinding HexText}"
                             FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                             FontSize="11.5"
                             Foreground="{DynamicResource VelaTextMutedBrush}" />
                </StackPanel>
              </Grid>

              <controls:VelaColorSpectrumCanvas x:Name="PART_Spectrum" Height="154" />

              <StackPanel Spacing="8">
                <controls:VelaColorBarCanvas x:Name="PART_HueBar" Height="16" />
                <controls:VelaColorBarCanvas x:Name="PART_AlphaBar"
                                             Height="16"
                                             IsVisible="{TemplateBinding ShowAlpha}" />
              </StackPanel>

              <Border Background="{DynamicResource VelaSurfaceMutedBrush}"
                      BorderBrush="{DynamicResource VelaBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="4"
                      Height="36">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Button x:Name="PART_FormatButton"
                          Theme="{DynamicResource VelaIconButtonTheme}"
                          Background="{DynamicResource VelaSurfaceBrush}"
                          BorderBrush="{DynamicResource VelaBorderSubtleBrush}"
                          BorderThickness="1"
                          CornerRadius="7"
                          Padding="8,0"
                          MinWidth="54"
                          Height="26">
                    <TextBlock Text="{TemplateBinding FormatLabel}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                  </Button>
                  <TextBox x:Name="PART_ValueInput"
                           Grid.Column="1"
                           Theme="{DynamicResource VelaBareTextBoxTheme}"
                           FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="4,0" />
                </Grid>
              </Border>

              <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                    ColumnSpacing="8"
                    IsVisible="{TemplateBinding ShowContrast}">
                <TextBlock Text="Aa"
                           FontSize="13.5"
                           FontWeight="Bold"
                           Foreground="{TemplateBinding PreviewBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{TemplateBinding ContrastRatioText}"
                           FontFamily="JetBrains Mono, Menlo, Consolas, monospace"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource VelaForegroundBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="contrast"
                           FontSize="11.5"
                           Foreground="{DynamicResource VelaTextMutedBrush}"
                           VerticalAlignment="Center" />
                <Border x:Name="PART_GradePill"
                        Grid.Column="3"
                        CornerRadius="6"
                        Padding="7,2"
                        Background="{DynamicResource VelaSuccessSubtleBrush}">
                  <TextBlock Text="{TemplateBinding ContrastGrade}"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource VelaSuccessBrush}" />
                </Border>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="PART_AddSwatch"
                        Theme="{DynamicResource VelaIconButtonTheme}"
                        Width="22"
                        Height="22"
                        CornerRadius="999"
                        Background="{DynamicResource VelaSurfaceMutedBrush}"
                        BorderBrush="{DynamicResource VelaBorderBrush}"
                        BorderThickness="1"
                        ToolTip.Tip="Save current color">
                  <PathIcon Width="11"
                            Height="11"
                            Data="{DynamicResource VelaIconPlus}"
                            Foreground="{DynamicResource VelaTextSecondaryBrush}" />
                </Button>
                <StackPanel x:Name="PART_SwatchesHost"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:pointerover /template/ Button#PART_Trigger">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderStrongBrush}" />
    </Style>
    <Style Selector="^:open /template/ Button#PART_Trigger">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccentBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
