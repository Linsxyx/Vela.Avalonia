<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Vela.Avalonia.Controls">

  <ControlTheme x:Key="{x:Type controls:VelaToolBarSeparator}" TargetType="controls:VelaToolBarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource VelaBorderBrush}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:VelaToolBarButton}" TargetType="controls:VelaToolBarButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Bg"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
            <PathIcon Width="14"
                      Height="14"
                      Data="{TemplateBinding Icon}"
                      Foreground="{TemplateBinding Foreground}"
                      VerticalAlignment="Center"
                      IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{TemplateBinding Label}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="{TemplateBinding FontWeight}"
                       Foreground="{TemplateBinding Foreground}"
                       VerticalAlignment="Center"
                       IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:not(:has-label)">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^:compact">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource VelaBorderSubtleBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:VelaToolBarToggleButton}" TargetType="controls:VelaToolBarToggleButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Bg"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.12" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
          </Border.Transitions>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
            <PathIcon Width="14"
                      Height="14"
                      Data="{TemplateBinding Icon}"
                      Foreground="{TemplateBinding Foreground}"
                      VerticalAlignment="Center"
                      IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{TemplateBinding Label}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="{TemplateBinding FontWeight}"
                       Foreground="{TemplateBinding Foreground}"
                       VerticalAlignment="Center"
                       IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:not(:has-label)">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^:compact">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Bg">
      <Setter Property="Background" Value="{DynamicResource VelaAccentSubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccentBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:VelaToolBar}" TargetType="controls:VelaToolBar">
    <Setter Property="Background" Value="{DynamicResource VelaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <DockPanel LastChildFill="True">
            <StackPanel x:Name="PART_TrailingHost"
                        DockPanel.Dock="Right"
                        Orientation="{TemplateBinding Orientation}"
                        Spacing="{TemplateBinding ItemSpacing}"
                        VerticalAlignment="Center" />
            <StackPanel x:Name="PART_ItemsHost"
                        Orientation="{TemplateBinding Orientation}"
                        Spacing="{TemplateBinding ItemSpacing}"
                        VerticalAlignment="Center" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:compact">
      <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="^:floating">
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderBrush}" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="^:floating /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="{DynamicResource VelaShadowRaised}" />
    </Style>
    <Style Selector="^:borderless">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^:vertical /template/ StackPanel#PART_TrailingHost">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:vertical /template/ StackPanel#PART_ItemsHost">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
