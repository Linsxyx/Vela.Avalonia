<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Vela.Avalonia.Controls">

  <ControlTheme x:Key="{x:Type controls:VelaComboBox}" TargetType="controls:VelaComboBox">
    <Setter Property="Foreground" Value="{DynamicResource VelaForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource VelaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="{DynamicResource VelaTextSm}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="6">
          <TextBlock Text="{TemplateBinding Label}"
                     FontSize="{DynamicResource VelaTextSm}"
                     FontWeight="Medium"
                     Foreground="{DynamicResource VelaForegroundBrush}"
                     IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Grid>
            <Border x:Name="PART_Anchor"
                    MinHeight="{TemplateBinding MinHeight}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="11,0,8,0">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.14" />
                  <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
              </Border.Transitions>

              <DockPanel LastChildFill="True">
                <PathIcon DockPanel.Dock="Left"
                          Width="14"
                          Height="14"
                          Margin="0,0,8,0"
                          Data="{DynamicResource VelaIconSearch}"
                          Foreground="{DynamicResource VelaTextMutedBrush}"
                          VerticalAlignment="Center" />

                <Button x:Name="PART_ToggleButton"
                        DockPanel.Dock="Right"
                        Theme="{DynamicResource VelaIconButtonTheme}"
                        Width="24"
                        Height="24"
                        CornerRadius="7"
                        Focusable="False">
                  <PathIcon x:Name="PART_Chevron"
                            Width="14"
                            Height="14"
                            Data="{DynamicResource VelaIconChevronDown}"
                            Foreground="{DynamicResource VelaTextMutedBrush}" />
                </Button>

                <Button x:Name="PART_ClearButton"
                        DockPanel.Dock="Right"
                        Theme="{DynamicResource VelaIconButtonTheme}"
                        Width="22"
                        Height="22"
                        Margin="2,0"
                        CornerRadius="999"
                        Focusable="False"
                        IsVisible="False">
                  <PathIcon Width="11"
                            Height="11"
                            Data="{DynamicResource VelaIconClose}"
                            Foreground="{DynamicResource VelaTextMutedBrush}" />
                </Button>

                <TextBox x:Name="PART_SearchBox"
                         Theme="{DynamicResource VelaBareTextBoxTheme}"
                         PlaceholderText="{TemplateBinding PlaceholderText}"
                         FontSize="{TemplateBinding FontSize}" />
              </DockPanel>
            </Border>

            <Popup x:Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   PlacementTarget="PART_Anchor"
                   Placement="BottomEdgeAlignedLeft"
                   VerticalOffset="6"
                   IsLightDismissEnabled="True">
              <controls:VelaPopupSurface Margin="6,2,6,14"
                                         Padding="5"
                                         CornerRadius="14"
                                         BorderThickness="1"
                                         Background="{DynamicResource VelaSurfaceRaisedBrush}"
                                         BorderBrush="{DynamicResource VelaBorderBrush}"
                                         BoxShadow="{DynamicResource VelaShadowFloating}">
                <StackPanel>
                  <ListBox x:Name="PART_ListBox"
                           MaxHeight="240"
                           Background="Transparent"
                           BorderThickness="0">
                    <ListBox.ItemContainerTheme>
                      <ControlTheme TargetType="ListBoxItem">
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="CornerRadius" Value="9" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                          <ControlTemplate>
                            <Border x:Name="PART_Row"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    MinHeight="{TemplateBinding MinHeight}">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" />
                                <PathIcon x:Name="PART_Check"
                                          Grid.Column="1"
                                          Width="14"
                                          Height="14"
                                          Data="{DynamicResource VelaIconCheck}"
                                          Foreground="{DynamicResource VelaForegroundBrush}"
                                          VerticalAlignment="Center"
                                          IsVisible="False" />
                              </Grid>
                            </Border>
                          </ControlTemplate>
                        </Setter>
                        <Style Selector="^:pointerover /template/ Border#PART_Row">
                          <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
                        </Style>
                        <Style Selector="^:selected /template/ Border#PART_Row">
                          <Setter Property="Background" Value="{DynamicResource VelaSurfaceMutedBrush}" />
                        </Style>
                        <Style Selector="^:selected /template/ PathIcon#PART_Check">
                          <Setter Property="IsVisible" Value="True" />
                        </Style>
                      </ControlTheme>
                    </ListBox.ItemContainerTheme>
                  </ListBox>

                  <TextBlock x:Name="PART_EmptyLabel"
                             Text="{TemplateBinding EmptyText}"
                             FontSize="13"
                             Foreground="{DynamicResource VelaTextMutedBrush}"
                             Padding="10,8"
                             IsVisible="False" />
                </StackPanel>
              </controls:VelaPopupSurface>
            </Popup>
          </Grid>

          <TextBlock Text="{TemplateBinding Description}"
                     FontSize="{DynamicResource VelaTextXs}"
                     Foreground="{DynamicResource VelaTextMutedBrush}"
                     TextWrapping="Wrap"
                     IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Anchor">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderStrongBrush}" />
    </Style>
    <Style Selector="^:focus-within /template/ Border#PART_Anchor">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#PART_Anchor">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaForegroundBrush}" />
    </Style>
    <Style Selector="^:has-value /template/ Button#PART_ClearButton">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
