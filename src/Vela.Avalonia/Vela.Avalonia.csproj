<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Vela.Avalonia</PackageId>
    <Authors>Vela.Avalonia Contributors</Authors>
    <Description>Motion-first, performance-engineered Avalonia 12 UI component library with analytical spring physics, OKLCH design tokens, SkSL ambient shaders, optical Liquid Glass surfaces, and an App Rail navigation shell.</Description>
    <PackageTags>avalonia;avaloniaui;ui;controls;theme;spring;motion;liquid-glass;shaders;net10</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>vela-icon.png</PackageIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vela.Avalonia.Tests" />
    <InternalsVisibleTo Include="Vela.Avalonia.HeadlessTests" />
    <InternalsVisibleTo Include="Vela.Avalonia.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\branding\vela-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
</Project>
